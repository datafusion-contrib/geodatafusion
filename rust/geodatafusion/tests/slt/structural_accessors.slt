# Structural accessor SQL contracts.
#
# References: PostGIS manual (`reference_accessor.xml`,
# `reference_processing.xml`) and `regress/core/dumppoints.sql`,
# `dumpsegments.sql`, `dump.sql`, and `summary.sql` at postgis/postgis
# commit 80fc3d3.

query IIBIIIBB
SELECT id, ST_Dimension(g), ST_IsCollection(g), ST_NumGeometries(g),
       ST_NRings(g), ST_Zmflag(g), ST_HasZ(g), ST_HasM(g)
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g
    FROM (VALUES
        (1, 'POINT(1 2)'),
        (2, 'LINESTRING Z (0 0 0,1 1 1)'),
        (3, 'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'),
        (4, 'MULTIPOINT((1 2),(3 4))'),
        (5, 'MULTILINESTRING ZM((0 0 1 2,1 1 3 4),(2 2 5 6,3 3 7 8))'),
        (6, 'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'),
        (7, 'POLYGON EMPTY'),
        (8, 'GEOMETRYCOLLECTION EMPTY')
    ) AS inputs(id, wkt)
) AS t
ORDER BY id;
----
1 0 false 1 0 0 false false
2 1 false 1 0 2 true false
3 2 false 1 2 0 false false
4 0 true 2 0 0 false false
5 1 true 2 0 3 true true
6 1 true 2 0 0 false false
7 2 false 0 0 0 false false
8 0 true 0 0 0 false false

query TTT
SELECT ST_AsText(ST_GeometryN(g, i)), ST_AsText(ST_PointN(g, i)),
       ST_AsText(ST_InteriorRingN(g, i))
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g, i
    FROM (VALUES
        (1, 'MULTIPOINT((1 2),(3 4))', 2),
        (2, 'LINESTRING(0 0,1 1,2 0)', 2),
        (3, 'LINESTRING(0 0,1 1,2 0)', -1),
        (4, 'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))', 1),
        (5, 'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))', 2),
        (6, 'MULTIPOINT((1 2),(3 4))', 3)
    ) AS inputs(id, wkt, i)
) AS t
ORDER BY id;
----
POINT(3 4) NULL NULL
NULL POINT(1 1) NULL
NULL POINT(2 0) NULL
POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1)) NULL LINESTRING(1 1,2 1,2 2,1 2,1 1)
NULL NULL NULL
NULL NULL NULL

query T
SELECT ST_AsText(ST_ExteriorRing(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))')));
----
LINESTRING(0 0,4 0,4 4,0 4,0 0)

query T
SELECT ST_AsText(ST_ExteriorRing(ST_GeomFromText('POLYGON EMPTY')));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_ExteriorRing(ST_GeomFromText('LINESTRING(0 0,1 1)')));
----
NULL

query T
SELECT ST_AsText(ST_ExteriorRing(ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 0)))')));
----
NULL

# ST_DumpPoints returns one (path, geom) record per coordinate.
query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpPoints(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'))) AS comp
) AS t;
----
POINT(0 0) [1]
POINT(1 1) [2]
POINT(2 0) [3]

query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpPoints(ST_GeomFromText(
        'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'
    ))) AS comp
) AS t;
----
POINT(0 0) [1, 1]
POINT(4 0) [1, 2]
POINT(4 4) [1, 3]
POINT(0 4) [1, 4]
POINT(0 0) [1, 5]
POINT(1 1) [2, 1]
POINT(2 1) [2, 2]
POINT(2 2) [2, 3]
POINT(1 2) [2, 4]
POINT(1 1) [2, 5]

query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpPoints(ST_GeomFromText(
        'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'
    ))) AS comp
) AS t;
----
POINT(1 2) [1, 1]
POINT(0 0) [2, 1]
POINT(1 1) [2, 2]

query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpPoints(ST_GeomFromText('POINT EMPTY'))) AS comp
) AS t;
----

# ST_DumpSegments returns one two-point LineString per segment.
query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpSegments(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'))) AS comp
) AS t;
----
LINESTRING(0 0,1 1) [1]
LINESTRING(1 1,2 0) [2]

query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpSegments(ST_GeomFromText(
        'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'
    ))) AS comp
) AS t;
----
LINESTRING(0 0,4 0) [1, 1]
LINESTRING(4 0,4 4) [1, 2]
LINESTRING(4 4,0 4) [1, 3]
LINESTRING(0 4,0 0) [1, 4]
LINESTRING(1 1,2 1) [2, 1]
LINESTRING(2 1,2 2) [2, 2]
LINESTRING(2 2,1 2) [2, 3]
LINESTRING(1 2,1 1) [2, 4]

query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpSegments(ST_GeomFromText('POINT(1 2)'))) AS comp
) AS t;
----

# ST_DumpRings is POLYGON-only; the exterior ring uses path [0].
query T?
SELECT ST_AsText(comp.geom), comp.path
FROM (
    SELECT unnest(ST_DumpRings(ST_GeomFromText(
        'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'
    ))) AS comp
) AS t;
----
POLYGON((0 0,4 0,4 4,0 4,0 0)) [0]
POLYGON((1 1,2 1,2 2,1 2,1 1)) [1]

statement error ST_DumpRings input must be a POLYGON
SELECT ST_DumpRings(ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 0)))'));

# ST_Points concatenates every coordinate, preserving duplicates.
query T
SELECT ST_AsText(ST_Points(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)')));
----
MULTIPOINT((0 0),(1 1),(2 0))

query T
SELECT ST_AsText(ST_Points(ST_GeomFromText(
    'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'
)));
----
MULTIPOINT((0 0),(4 0),(4 4),(0 4),(0 0),(1 1),(2 1),(2 2),(1 2),(1 1))

query T
SELECT ST_AsText(ST_Points(ST_GeomFromText(
    'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'
)));
----
MULTIPOINT((1 2),(0 0),(1 1))

query T
SELECT ST_AsText(ST_Points(ST_GeomFromText('POINT ZM (1 2 3 4)')));
----
MULTIPOINT ZM((1 2 3 4))

query T
SELECT ST_AsText(ST_Points(ST_GeomFromText('POINT EMPTY')));
----
MULTIPOINT EMPTY

# ST_Summary matches the PostGIS layout; the cached-bbox B flag is omitted
# because GeoArrow has no cached bounding box.
query T
SELECT ST_Summary(ST_GeomFromText('POINT M (1 2 3)'));
----
Point[M]

query T
SELECT replace(ST_Summary(ST_GeomFromText(
    'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'
)), chr(10), '|');
----
Polygon[] with 2 rings:|   ring 0 has 5 points|   ring 1 has 5 points

query T
SELECT replace(ST_Summary(ST_GeomFromText(
    'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'
)), chr(10), '|');
----
GeometryCollection[] with 2 elements:|  Point[]|  LineString[] with 2 points

query T
SELECT ST_Summary(ST_GeomFromText('LINESTRING EMPTY'));
----
LineString[] with 0 points

query T
SELECT ST_Summary(ST_GeomFromEWKT('SRID=4326;POINT(1 2)'));
----
Point[S]

query T
SELECT ST_Summary(ST_GeomFromText(NULL));
----
NULL

# ST_MemSize reports the Arrow buffers referenced by one row: dense-union
# type id and offset slots, list offsets, and coordinate payload. It is not
# the PostGIS GSERIALIZED or EWKB size.
query I
SELECT ST_MemSize(ST_GeomFromText('POINT(1 2)'));
----
21

query I
SELECT ST_MemSize(ST_GeomFromText('POINT Z (1 2 3)'));
----
29

query I
SELECT ST_MemSize(ST_GeomFromText('LINESTRING(0 0,1 1)'));
----
45

query I
SELECT ST_MemSize(ST_GeomFromText('POLYGON EMPTY'));
----
17

query I
SELECT ST_MemSize(ST_GeomFromText(NULL));
----
NULL
