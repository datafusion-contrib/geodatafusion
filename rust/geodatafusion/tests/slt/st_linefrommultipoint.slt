query T
SELECT ST_AsText(
  ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT((1 2),(3 4),(5 6))'))
);
----
LINESTRING(1 2,3 4,5 6)

query T
SELECT ST_AsText(
  ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT((1 2))'))
);
----
LINESTRING(1 2)

query T
SELECT ST_AsText(
  ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT EMPTY'))
);
----
LINESTRING EMPTY

query TTTT
SELECT
  ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT Z((1 2 3),(4 5 6))'))),
  ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT M((1 2 3),(4 5 6))'))),
  ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT ZM((1 2 3 4),(5 6 7 8))'))),
  ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT M EMPTY')));
----
LINESTRING Z(1 2 3,4 5 6) LINESTRING M(1 2 3,4 5 6) LINESTRING ZM(1 2 3 4,5 6 7 8) LINESTRING M EMPTY

query T
SELECT ST_AsText(
  ST_LineFromMultiPoint(
    ST_GeomFromWKB(
      ST_AsBinary(ST_GeomFromText('MULTIPOINT((1 2),(3 4))'))
    )
  )
);
----
LINESTRING(1 2,3 4)

query T
SELECT ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText(wkt)))
FROM (
  VALUES ('MULTIPOINT((0 0),(1 1))'), (NULL)
) AS points(wkt);
----
LINESTRING(0 0,1 1)
NULL

query B
SELECT ST_LineFromMultiPoint(NULL) IS NULL;
----
true

query BB
SELECT ST_LineFromMultiPoint(geom) IS NULL
FROM (VALUES (NULL), (NULL)) AS points(geom);
----
true
true

statement error
SELECT ST_LineFromMultiPoint(ST_GeomFromText('POINT(1 2)'));

statement error
SELECT ST_LineFromMultiPoint(
  ST_GeomFromText('GEOMETRYCOLLECTION(MULTIPOINT((1 2),(3 4)))')
);

statement error
SELECT ST_LineFromMultiPoint(
  ST_GeomFromText('MULTIPOINT(EMPTY,(1 2))')
);
