query IIII
SELECT
  ST_Zmflag(ST_GeomFromText('POINT(1 2)')),
  ST_Zmflag(ST_GeomFromText('POINT M(1 2 4)')),
  ST_Zmflag(ST_GeomFromText('POINT Z(1 2 3)')),
  ST_Zmflag(ST_GeomFromText('POINT ZM(1 2 3 4)'));
----
0 1 2 3

query IIII
SELECT
  ST_Zmflag(ST_GeomFromText('POINT EMPTY')),
  ST_Zmflag(ST_GeomFromText('POINT M EMPTY')),
  ST_Zmflag(ST_GeomFromText('POINT Z EMPTY')),
  ST_Zmflag(ST_GeomFromText('POINT ZM EMPTY'));
----
0 1 2 3

query II
SELECT
  ST_Zmflag(ST_GeomFromText('GEOMETRYCOLLECTION M(POINT M(1 2 4))')),
  ST_Zmflag(ST_GeomFromText('GEOMETRYCOLLECTION Z(POINT Z(1 2 3))'));
----
1 2

