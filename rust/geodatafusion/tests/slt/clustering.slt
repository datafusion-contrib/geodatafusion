# PostGIS clustering contracts.
#
# Values were checked against the pinned PostGIS reference described in
# tests/postgis/README.md. The window functions are exercised through real
# OVER clauses; the aggregate forms are exercised through the public SQL entry
# point and through `tests/postgis/clustering` raw Arrow baselines.

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText('POINT (1 0)')),
    (3, ST_GeomFromText('POINT (10 0)')))
SELECT id, ST_ClusterDBSCAN(geom, 1.0, 1) OVER (ORDER BY id) FROM t ORDER BY id;
----
1 0
2 0
3 1

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText('POINT (1 0)')),
    (3, ST_GeomFromText('POINT (10 0)')))
SELECT id, ST_ClusterWithinWin(geom, 0.5) OVER (ORDER BY id) FROM t ORDER BY id;
----
1 0
2 1
3 2

# Window frames are ignored: the clustering functions always read the whole
# PARTITION BY group, matching PostGIS.
query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText('POINT (1 0)')),
    (3, ST_GeomFromText('POINT (10 0)')))
SELECT id, ST_ClusterWithinWin(geom, 1.0)
    OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND CURRENT ROW)
FROM t ORDER BY id;
----
1 0
2 0
3 1

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText('POINT (1 0)')),
    (3, ST_GeomFromText('POINT (10 0)')))
SELECT id, ST_ClusterKMeans(geom, 2) OVER (ORDER BY id) FROM t ORDER BY id;
----
1 1
2 1
3 0

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('LINESTRING (0 0, 1 1)')),
    (2, ST_GeomFromText('LINESTRING (1 1, 2 2)')),
    (3, ST_GeomFromText('LINESTRING (5 5, 6 6)')))
SELECT id, ST_ClusterIntersectingWin(geom) OVER (ORDER BY id) FROM t ORDER BY id;
----
1 0
2 0
3 1

query IIB
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText(NULL)),
    (3, ST_GeomFromText('POINT EMPTY')),
    (4, ST_GeomFromText('POINT (10 10)')))
SELECT id, ST_ClusterWithinWin(geom, 100) OVER (),
       ST_ClusterWithinWin(geom, 100) OVER () IS NULL
FROM t ORDER BY id;
----
1 0 false
2 NULL true
3 2 false
4 0 false

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText(NULL)),
    (3, ST_GeomFromText('POINT EMPTY')),
    (4, ST_GeomFromText('POINT (10 10)')))
SELECT id, ST_ClusterDBSCAN(geom, 100, 2) OVER () FROM t ORDER BY id;
----
1 0
2 NULL
3 NULL
4 0

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)')),
    (2, ST_GeomFromText(NULL)),
    (3, ST_GeomFromText('POINT EMPTY')),
    (4, ST_GeomFromText('POINT (10 10)')))
SELECT id, ST_ClusterDBSCAN(geom, 100, 1) OVER () FROM t ORDER BY id;
----
1 0
2 NULL
3 2
4 0

# Window parameters use the first row of the partition, matching PostGIS.
query II
WITH t(id, geom, distance) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)'), 0.5),
    (2, ST_GeomFromText('POINT (1 0)'), 0.5),
    (3, ST_GeomFromText('POINT (10 0)'), 1000.0))
SELECT id, ST_ClusterWithinWin(geom, distance) OVER () FROM t ORDER BY id;
----
1 0
2 1
3 2

query IIB
WITH t(id, geom, eps, minpoints) AS (VALUES
    (1, ST_GeomFromText('POINT (0 0)'), 0.5, 2),
    (2, ST_GeomFromText('POINT (1 0)'), 1000.0, 2))
SELECT id, ST_ClusterDBSCAN(geom, eps, minpoints) OVER (),
       ST_ClusterDBSCAN(geom, eps, minpoints) OVER () IS NULL
FROM t ORDER BY id;
----
1 NULL true
2 NULL true

query III
WITH t(part, id, geom) AS (VALUES
    (1, 1, ST_GeomFromText('POINT (0 0)')),
    (1, 2, ST_GeomFromText('POINT (0.2 0)')),
    (1, 3, ST_GeomFromText('POINT (10 0)')),
    (2, 1, ST_GeomFromText('POINT (50 0)')),
    (2, 2, ST_GeomFromText('POINT (50.2 0)')),
    (2, 3, ST_GeomFromText('POINT (60 0)')))
SELECT part, id, ST_ClusterDBSCAN(geom, 0.5, 1) OVER (PARTITION BY part)
FROM t ORDER BY part, id;
----
1 1 0
1 2 0
1 3 1
2 1 0
2 2 0
2 3 1

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText(NULL)),
    (2, ST_GeomFromText('POINT EMPTY')))
SELECT id, ST_ClusterKMeans(geom, 1) OVER () FROM t ORDER BY id;
----
1 -1
2 -1

query II
SELECT ST_ClusterKMeans(ST_GeomFromText('POINT (0 0)'), NULL) OVER (),
       ST_ClusterKMeans(ST_GeomFromText('POINT (0 0)'), 0) OVER ();
----
NULL NULL

# Two- and three-argument overloads agree when max_radius is absent.
query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT M (0 0 1)')),
    (2, ST_GeomFromText('POINT M (1 0 1)')),
    (3, ST_GeomFromText('POINT M (2 0 10000)')))
SELECT id, ST_ClusterKMeans(geom, 1) OVER () FROM t ORDER BY id;
----
1 0
2 0
3 0

query II
WITH t(id, geom) AS (VALUES
    (1, ST_GeomFromText('POINT M (0 0 1)')),
    (2, ST_GeomFromText('POINT M (1 0 1)')),
    (3, ST_GeomFromText('POINT M (2 0 10000)')))
SELECT id, ST_ClusterKMeans(geom, 1, 1) OVER () FROM t ORDER BY id;
----
1 1
2 0
3 0

# Integer literals are accepted for float8 parameters.
query I
SELECT ST_ClusterDBSCAN(ST_GeomFromText('POINT (0 0)'), 1, 1) OVER ();
----
0

query I
SELECT ST_ClusterWithinWin(ST_GeomFromText('POINT (0 0)'), 0) OVER ();
----
0

query B
SELECT ST_ClusterIntersecting(ST_GeomFromText(NULL)) IS NULL;
----
true

# Bare NULL resolves through the real signatures. The window functions keep
# their documented NULL/sentinel behavior instead of failing to plan.
query IB
SELECT ST_ClusterKMeans(NULL, 1) OVER (),
       ST_ClusterKMeans(NULL, 1) OVER () IS NOT NULL;
----
-1 true

query BBB
SELECT ST_ClusterDBSCAN(NULL, 1, 1) OVER () IS NULL,
       ST_ClusterWithinWin(NULL, 1) OVER () IS NULL,
       ST_ClusterIntersectingWin(NULL) OVER () IS NULL;
----
true true true

query B
SELECT ST_ClusterIntersecting(NULL) IS NULL;
----
true

query B
SELECT ST_ClusterIntersecting(ST_GeomFromText('POLYGON EMPTY')) IS NOT NULL;
----
true

query B
WITH t(geom) AS (VALUES (ST_GeomFromText('POINT (0 0)')))
SELECT ST_ClusterWithin(geom, 1.0) IS NOT NULL FROM t;
----
true

query B
SELECT ST_ClusterWithin(ST_GeomFromText(NULL), 1.0) IS NULL;
----
true

statement error Tolerance must be a positive number, got -1
SELECT ST_ClusterDBSCAN(ST_GeomFromText('POINT (0 0)'), -1, 1) OVER ();

statement error Minpoints must be a positive number, got -1
SELECT ST_ClusterDBSCAN(ST_GeomFromText('POINT (0 0)'), 1, -1) OVER ();

statement error Tolerance must be a positive number, got 0
SELECT ST_ClusterWithinWin(ST_GeomFromText('POINT (0 0)'), NULL) OVER ();

statement error Tolerance not defined
SELECT ST_ClusterWithin(ST_GeomFromText('POINT (0 0)'), 0.0);

statement error Tolerance not defined
SELECT ST_ClusterWithin(ST_GeomFromText('POINT (0 0)'), NULL);

statement error Tolerance must be a positive number
SELECT ST_ClusterWithin(ST_GeomFromText('POINT (0 0)'), -1.0);

statement error K \(3\) must be smaller than the number of rows in the group \(2\)
WITH t(geom) AS (VALUES
    (ST_GeomFromText('POINT (0 0)')),
    (ST_GeomFromText('POINT (1 1)')))
SELECT ST_ClusterKMeans(geom, 3) OVER () FROM t;

# The aggregate returns List<Struct{geom: geoarrow.wkb}>, so geometry UDFs compose
# on cluster.geom through standard struct-field expansion.
query TTT
SELECT ST_AsText(cluster.geom), ST_AsEWKT(cluster.geom),
       ST_AsText(ST_Force2D(cluster.geom)) FROM (
    SELECT unnest(ST_ClusterWithin(geom, 1.0)) AS cluster FROM (
        VALUES
            (ST_GeomFromEWKT('SRID=4326;POINT (0 0)')),
            (ST_GeomFromEWKT('SRID=4326;POINT (10 0)'))
    ) AS t(geom)
) ORDER BY 1;
----
GEOMETRYCOLLECTION(POINT(0 0)) SRID=4326;GEOMETRYCOLLECTION(POINT(0 0)) GEOMETRYCOLLECTION(POINT(0 0))
GEOMETRYCOLLECTION(POINT(10 0)) SRID=4326;GEOMETRYCOLLECTION(POINT(10 0)) GEOMETRYCOLLECTION(POINT(10 0))
