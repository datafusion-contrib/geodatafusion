# WKT/WKB input, output, and aliases.

query T
SELECT ST_AsText(ST_GeomFromText('POINT(30 10)'));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_GeometryFromText('POINT(30 10)'));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_WKTToSQL('POINT(30 10)'));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_GeomFromWKB(ST_AsBinary(ST_GeomFromText('POINT(30 10)'))));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_WKBToSQL(ST_AsBinary(ST_GeomFromText('LINESTRING(0 0, 1 1)'))));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_GeomFromText(NULL));
----
NULL

# Type-specific WKT constructors.

query T
SELECT ST_AsText(ST_PointFromText('POINT(30 10)'));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_PointFromText('POINT(30 10)', 4326));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_LineFromText('LINESTRING(0 0,1 1)', 0));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_LineFromText('LINESTRING Z (0 0 1,1 1 2)'));
----
LINESTRING Z(0 0 1,1 1 2)

query T
SELECT ST_AsText(ST_PolygonFromText('POLYGON((0 0,0 1,1 1,0 0))'));
----
POLYGON((0 0,0 1,1 1,0 0))

query T
SELECT ST_AsText(ST_MPointFromText('MULTIPOINT(0 0,1 1)'));
----
MULTIPOINT((0 0),(1 1))

query T
SELECT ST_AsText(ST_MLineFromText('MULTILINESTRING((0 0,1 1),(2 2,3 3))', 4326));
----
MULTILINESTRING((0 0,1 1),(2 2,3 3))

query T
SELECT ST_AsText(ST_MPolyFromText('MULTIPOLYGON(((0 0,0 1,1 1,0 0)))'));
----
MULTIPOLYGON(((0 0,0 1,1 1,0 0)))

query T
SELECT ST_AsText(ST_GeomCollFromText(
    'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(3 4,5 6))',
    4326
));
----
GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(3 4,5 6))

query T
SELECT ST_AsText(ST_GeomCollFromText('GEOMETRYCOLLECTION EMPTY', 4326));
----
GEOMETRYCOLLECTION EMPTY

query B
SELECT ST_PointFromText('LINESTRING(0 0,1 1)') IS NULL;
----
true

query B
SELECT ST_LineFromText('POINT(0 0)') IS NULL;
----
true

query B
SELECT ST_GeomCollFromText('POINT(0 0)') IS NULL;
----
true

query B
SELECT ST_PointFromText(NULL) IS NULL;
----
true

query T
SELECT ST_AsText(ST_PointFromText('POINT EMPTY', -1));
----
POINT EMPTY

query T
SELECT ST_AsText(ST_PointFromText('POINT ZM (1 2 3 4)', 1000000));
----
POINT ZM(1 2 3 4)

# Type-specific WKB constructors.

query T
SELECT ST_AsText(ST_PointFromWKB(X'01010000000000000000003E400000000000002440'));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_PointFromWKB(
    X'01010000000000000000003E400000000000002440',
    4326
));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_LineFromWKB(
    X'01020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F'
));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_LinestringFromWKB(
    X'01020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F',
    4326
));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_LineFromWKB(
    X'01BA0B00000200000000000000000000000000000000000000000000000000F03F0000000000000040000000000000F03F000000000000004000000000000008400000000000001040',
    1000000
));
----
LINESTRING ZM(0 0 1 2,1 2 3 4)

query B
SELECT ST_PointFromWKB(
    X'01020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F'
) IS NULL;
----
true

query B
SELECT ST_LineFromWKB(
    X'01010000000000000000003E400000000000002440'
) IS NULL;
----
true

query B
SELECT ST_PointFromWKB(NULL) IS NULL;
----
true

query B
SELECT ST_PointFromWKB(
    X'01010000000000000000003E400000000000002440',
    NULL
) IS NULL;
----
true

# Generic aliases and multi-row inputs.

query T
SELECT ST_AsText(ST_GeometryFromText('POINT(1 2)'));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_WKTToSQL('LINESTRING(0 0,1 1)'));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_WKBToSQL(
    X'01010000000000000000003E400000000000002440'
));
----
POINT(30 10)

query T
SELECT ST_AsText(ST_GeomFromWKB(ST_AsBinary(
    ST_GeomFromText('POINT ZM (1 2 3 4)')
)));
----
POINT ZM(1 2 3 4)

query T
SELECT ST_AsText(ST_GeomFromText(wkt))
FROM (
    VALUES
        ('POINT(0 0)'),
        ('LINESTRING ZM (0 0 1 2,1 2 3 4)'),
        ('POLYGON EMPTY')
) AS t(wkt);
----
POINT(0 0)
LINESTRING ZM(0 0 1 2,1 2 3 4)
POLYGON EMPTY

query T
SELECT ST_AsText(ST_GeomFromWKB(wkb))
FROM (
    VALUES
        (X'01010000000000000000003E400000000000002440'),
        (X'01BA0B00000200000000000000000000000000000000000000000000000000F03F0000000000000040000000000000F03F000000000000004000000000000008400000000000001040'),
        (X'010300000000000000')
) AS t(wkb);
----
POINT(30 10)
LINESTRING ZM(0 0 1 2,1 2 3 4)
POLYGON EMPTY

statement error WKT
SELECT ST_PointFromText('POINT(1 2', 4326);

statement error buffer
SELECT ST_PointFromWKB(X'00', 4326);
