# Native planar processing SQL contracts.
#
# Expected values are the pinned PostGIS 3.6.4 / GEOS 3.14.1 reference
# results unless a case documents a deliberate two-dimensional boundary.

# ST_Area

query R
SELECT ST_Area(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))'));
----
100

query R
SELECT ST_Area(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,2 8,8 8,8 2,2 2))'));
----
64

query R
SELECT ST_Area(ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 1,0 0)),((10 10,11 10,11 11,10 11,10 10)))'));
----
2

query R
SELECT ST_Area(ST_GeomFromText('GEOMETRYCOLLECTION(POLYGON((0 0,1 0,1 1,0 1,0 0)),LINESTRING(0 0,5 0))'));
----
1

query R
SELECT ST_Area(ST_GeomFromText('POINT(1 2)'));
----
0

query R
SELECT ST_Area(ST_GeomFromText('LINESTRING(0 0,3 4)'));
----
0

query R
SELECT ST_Area(ST_GeomFromText('POLYGON EMPTY'));
----
0

# ST_Area ignores Z and M ordinates.

query R
SELECT ST_Area(ST_GeomFromText('POLYGON Z ((0 0 1,10 0 2,10 10 3,0 10 4,0 0 1))'));
----
100

query R
SELECT ST_Area(ST_GeomFromText('POLYGON M ((0 0 1,10 0 2,10 10 3,0 10 4,0 0 1))'));
----
100

query B
SELECT ST_Area(NULL) IS NULL;
----
true

# ST_Centroid

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('POINT(1 2)')));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('LINESTRING(0 0,10 0)')));
----
POINT(5 0)

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,1 9,9 9,9 1,1 1))')));
----
POINT(5 5)

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0),LINESTRING(0 0,2 2))')));
----
POINT(1 1)

# ST_Centroid always returns a two-dimensional point in PostGIS.

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('LINESTRING Z (0 0 1,2 2 3)')));
----
POINT(1 1)

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('POINT EMPTY')));
----
POINT EMPTY

query T
SELECT ST_AsText(ST_Centroid(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')));
----
POINT EMPTY

query B
SELECT ST_Centroid(NULL) IS NULL;
----
true

# ST_PointOnSurface

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('LINESTRING(0 0,5 5,10 0)')));
----
POINT(5 5)

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('MULTILINESTRING((0 0,10 0),(0 5,10 5))')));
----
POINT(0 0)

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,1 9,9 9,9 1,1 1))')));
----
POINT(0.5 5)

# GeoDataFusion exposes a two-dimensional result; PostGIS keeps the Z
# ordinate for lineal inputs such as LINESTRING Z (0 0 9,5 5 5,10 0 1).

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('LINESTRING Z (0 0 9,5 5 5,10 0 1)')));
----
POINT(5 5)

# M and ZM lineal inputs also produce a two-dimensional point.

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('LINESTRING M (0 0 9,5 5 5,10 0 1)')));
----
POINT(5 5)

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('LINESTRING ZM (0 0 9 1,5 5 5 2,10 0 1 3)')));
----
POINT(5 5)

query T
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('POINT EMPTY')));
----
POINT EMPTY

query B
SELECT ST_PointOnSurface(NULL) IS NULL;
----
true

# ST_ConvexHull

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('POINT(1 2)')));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('MULTIPOINT((0 0),(2 2))')));
----
LINESTRING(0 0,2 2)

query B
SELECT ST_GeometryType(ST_ConvexHull(ST_GeomFromText('MULTIPOINT((0 0),(0 1),(1 1),(1 0))'))) = 'ST_Polygon';
----
true

query B
SELECT abs(ST_Area(ST_ConvexHull(ST_GeomFromText('MULTIPOINT((0 0),(0 1),(1 1),(1 0))'))) - 1) < 1e-6;
----
true

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('POINT EMPTY')));
----
POINT EMPTY

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('LINESTRING EMPTY')));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('POLYGON EMPTY')));
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')));
----
GEOMETRYCOLLECTION EMPTY

# GeoDataFusion computes hulls over XY; PostGIS preserves Z on non-empty hulls.

query T
SELECT ST_AsText(ST_ConvexHull(ST_GeomFromText('POINT Z (1 2 3)')));
----
POINT(1 2)

# M and ZM inputs produce a two-dimensional hull.

query I
SELECT ST_Zmflag(ST_ConvexHull(ST_GeomFromText('MULTIPOINT M ((0 0 1),(0 1 2),(1 1 3),(1 0 4))')));
----
0

query I
SELECT ST_Zmflag(ST_ConvexHull(ST_GeomFromText('MULTIPOINT ZM ((0 0 1 1),(0 1 2 2),(1 1 3 3),(1 0 4 4))')));
----
0

query B
SELECT ST_ConvexHull(NULL) IS NULL;
----
true

# ST_OrientedEnvelope

query T
SELECT ST_AsText(ST_OrientedEnvelope(ST_GeomFromText('POINT(1 2)')));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_OrientedEnvelope(ST_GeomFromText('LINESTRING(0 0,2 2)')));
----
LINESTRING(0 0,2 2)

query B
SELECT ST_GeometryType(ST_OrientedEnvelope(ST_GeomFromText('MULTIPOINT((0 0),(0 2),(2 2),(2 0))'))) = 'ST_Polygon';
----
true

query B
SELECT abs(ST_Area(ST_OrientedEnvelope(ST_GeomFromText('MULTIPOINT((0 0),(0 2),(2 2),(2 0))'))) - 4) < 1e-6;
----
true

query T
SELECT ST_AsText(ST_OrientedEnvelope(ST_GeomFromText('POINT EMPTY')));
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_OrientedEnvelope(ST_GeomFromText('LINESTRING EMPTY')));
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_OrientedEnvelope(ST_GeomFromText('POLYGON EMPTY')));
----
POLYGON EMPTY

# PostGIS also drops Z on oriented envelopes.

query T
SELECT ST_AsText(ST_OrientedEnvelope(ST_GeomFromText('LINESTRING Z (0 0 1,2 2 3)')));
----
LINESTRING(0 0,2 2)

query B
SELECT ST_OrientedEnvelope(NULL) IS NULL;
----
true

# Robust hull degeneracy: tiny cross products and large-coordinate translations

query B
SELECT ST_GeometryType(ST_ConvexHull(ST_GeomFromText('MULTIPOINT((0 0),(0.00000001 0),(0 0.00000001))'))) = 'ST_Polygon';
----
true

query B
SELECT ST_GeometryType(ST_OrientedEnvelope(ST_GeomFromText('MULTIPOINT((0 0),(0.00000001 0),(0 0.00000001))'))) = 'ST_Polygon';
----
true

query B
SELECT ST_GeometryType(ST_ConvexHull(ST_GeomFromText('MULTIPOINT((1000000 1000000),(1000000.000001 1000000),(1000000 1000000.000001))'))) = 'ST_Polygon';
----
true

query B
SELECT ST_GeometryType(ST_OrientedEnvelope(ST_GeomFromText('MULTIPOINT((1000000 1000000),(1000000.000001 1000000),(1000000 1000000.000001))'))) = 'ST_Polygon';
----
true

query B
SELECT abs(ST_Area(ST_ConvexHull(ST_GeomFromText('MULTIPOINT((1000000000000 1000000000000),(1000000000010 1000000000000),(1000000000000 1000000000010))'))) - 50) < 1e-9;
----
true

# ST_Simplify

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), 2));
----
LINESTRING(0 0,2 0)

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), -2));
----
LINESTRING(0 0,2 0)

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), 0.5));
----
LINESTRING(0 0,1 1,2 0)

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING EMPTY'), 1));
----
LINESTRING EMPTY

# GeoDataFusion keeps the planar XY contract; PostGIS preserves Z.

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING Z (0 0 1,1 1 2,2 0 3)'), 2));
----
LINESTRING(0 0,2 0)

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING M (0 0 1,1 1 2,2 0 3)'), 2));
----
LINESTRING(0 0,2 0)

query T
SELECT ST_AsText(ST_Simplify(ST_GeomFromText('LINESTRING ZM (0 0 1 1,1 1 2 2,2 0 3 3)'), 2));
----
LINESTRING(0 0,2 0)

query B
SELECT ST_Simplify(NULL, 1) IS NULL;
----
true

query B
SELECT ST_Simplify(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), NULL) IS NULL;
----
true

# ST_SimplifyVW

query T
SELECT ST_AsText(ST_SimplifyVW(ST_GeomFromText('LINESTRING(5 2,3 8,6 20,7 25,10 10)'), 30));
----
LINESTRING(5 2,7 25,10 10)

query T
SELECT ST_AsText(ST_SimplifyVW(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), 0));
----
LINESTRING(0 0,1 1,2 0)

query T
SELECT ST_AsText(ST_SimplifyVW(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), -0.5));
----
LINESTRING(0 0,1 1,2 0)

query T
SELECT ST_AsText(ST_SimplifyVW(ST_GeomFromText('LINESTRING EMPTY'), 1));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_SimplifyVW(ST_GeomFromText('LINESTRING M (5 2 1,3 8 2,6 20 3,7 25 4,10 10 5)'), 30));
----
LINESTRING(5 2,7 25,10 10)

query T
SELECT ST_AsText(ST_SimplifyVW(ST_GeomFromText('LINESTRING ZM (5 2 1 10,3 8 2 20,6 20 3 30,7 25 4 40,10 10 5 50)'), 30));
----
LINESTRING(5 2,7 25,10 10)

query B
SELECT ST_SimplifyVW(NULL, 1) IS NULL;
----
true

query B
SELECT ST_SimplifyVW(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), NULL) IS NULL;
----
true

# ST_SimplifyPreserveTopology

query T
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), 2));
----
LINESTRING(0 0,2 0)

query T
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), 0.5));
----
LINESTRING(0 0,1 1,2 0)

query T
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING EMPTY'), 1));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING M (0 0 1,1 1 2,2 0 3)'), 2));
----
LINESTRING(0 0,2 0)

query T
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING ZM (0 0 1 1,1 1 2 2,2 0 3 3)'), 2));
----
LINESTRING(0 0,2 0)

query B
SELECT ST_SimplifyPreserveTopology(NULL, 1) IS NULL;
----
true

query B
SELECT ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), NULL) IS NULL;
----
true

statement error Tolerance must be non-negative
SELECT ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING(0 0,1 1,2 0)'), -0.5);
