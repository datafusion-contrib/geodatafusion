# Bounding box scalar functions: Box2D, Box3D, ST_Envelope, ST_Expand,
# ST_MakeBox2D, ST_3DMakeBox, and the ST_*Min/ST_*Max accessors.

query RRRR
SELECT
    ST_XMin(Box2D(ST_GeomFromText('LINESTRING(1 2,3 4)'))),
    ST_YMin(Box2D(ST_GeomFromText('LINESTRING(1 2,3 4)'))),
    ST_XMax(Box2D(ST_GeomFromText('LINESTRING(1 2,3 4)'))),
    ST_YMax(Box2D(ST_GeomFromText('LINESTRING(1 2,3 4)')));
----
1 2 3 4

query RR
SELECT
    ST_ZMin(ST_GeomFromText('LINESTRING(1 2,3 4)')),
    ST_ZMax(ST_GeomFromText('LINESTRING(1 2,3 4)'));
----
0 0

query RRRRRR
SELECT
    ST_XMin(ST_GeomFromText('LINESTRING Z (1 2 3,3 4 5)')),
    ST_YMin(ST_GeomFromText('LINESTRING Z (1 2 3,3 4 5)')),
    ST_ZMin(ST_GeomFromText('LINESTRING Z (1 2 3,3 4 5)')),
    ST_XMax(ST_GeomFromText('LINESTRING Z (1 2 3,3 4 5)')),
    ST_YMax(ST_GeomFromText('LINESTRING Z (1 2 3,3 4 5)')),
    ST_ZMax(ST_GeomFromText('LINESTRING Z (1 2 3,3 4 5)'));
----
1 2 3 3 4 5

query TTTT
SELECT
    ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING(0 1,5 1)'))),
    ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING(0 0,1 3)'))),
    ST_AsText(ST_Envelope(ST_GeomFromText('POINT EMPTY'))),
    ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING Z (1 2 3,4 5 7)')));
----
LINESTRING(0 1,5 1) POLYGON((0 0,0 3,1 3,1 0,0 0)) POINT EMPTY POLYGON((1 2,1 5,4 5,4 2,1 2))

query T
SELECT ST_AsEWKT(ST_MakeBox2D(ST_Point(10, 20), ST_Point(0, 5)));
----
POLYGON((0 5,0 20,10 20,10 5,0 5))

query RRRRRR
SELECT
    ST_XMin(ST_3DMakeBox(ST_PointZ(10, 10, 20), ST_PointZ(0, 0, 0))),
    ST_YMin(ST_3DMakeBox(ST_PointZ(10, 10, 20), ST_PointZ(0, 0, 0))),
    ST_ZMin(ST_3DMakeBox(ST_PointZ(10, 10, 20), ST_PointZ(0, 0, 0))),
    ST_XMax(ST_3DMakeBox(ST_PointZ(10, 10, 20), ST_PointZ(0, 0, 0))),
    ST_YMax(ST_3DMakeBox(ST_PointZ(10, 10, 20), ST_PointZ(0, 0, 0))),
    ST_ZMax(ST_3DMakeBox(ST_PointZ(10, 10, 20), ST_PointZ(0, 0, 0)));
----
0 0 0 10 10 20

query T
SELECT ST_AsText(ST_Expand(ST_GeomFromText('POINT(1 2)'), -1));
----
POLYGON((2 3,2 1,0 1,0 3,2 3))

query B
SELECT
    Box2D(NULL) IS NULL
    AND Box3D(NULL) IS NULL
    AND ST_XMin(NULL) IS NULL
    AND ST_ZMin(NULL) IS NULL;
----
true

statement error box input
SELECT ST_Expand(ST_MakeBox2D(ST_Point(0, 5), ST_Point(10, 20)), 1, 2, 3);

statement error constant Z
SELECT ST_AsEWKB(ST_3DMakeBox(ST_PointZ(0, 0, 0), ST_PointZ(1, 1, 20)));

statement error Failed to coerce
SELECT ST_3DMakeBox(ST_Point(0, 0), ST_Point(1, 1));
