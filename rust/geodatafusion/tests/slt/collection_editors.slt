# Collection conversion and polygon-orientation SQL contracts.

query T
SELECT ST_AsText(ST_CollectionExtract(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0),LINESTRING(1 1,2 2))')));
----
MULTILINESTRING((1 1,2 2))

statement error nested GeometryCollection is not supported
SELECT ST_AsText(ST_CollectionExtract(ST_GeomFromText('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(LINESTRING(0 0,1 1)),LINESTRING(2 2,3 3))'), 2));

query T
SELECT ST_AsText(ST_CollectionExtract(ST_GeomFromText('POINT ZM(1 2 3 4)'), 2));
----
LINESTRING ZM EMPTY

query T
SELECT ST_AsText(ST_CollectionExtract(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')));
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_AsText(ST_CollectionExtract(ST_GeomFromText('GEOMETRYCOLLECTION(MULTIPOINT EMPTY)'), 1));
----
MULTIPOINT EMPTY

statement error only point, linestring and polygon may be extracted
SELECT ST_CollectionExtract(ST_GeomFromText('POINT(0 0)'), 4);

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0))')));
----
POINT(0 0)

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('MULTIPOINT((0 0))')));
----
POINT(0 0)

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0),POINT(1 1))')));
----
MULTIPOINT((0 0),(1 1))

statement error nested GeometryCollection is not supported
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0),GEOMETRYCOLLECTION(LINESTRING(1 1,2 2)))')));

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('GEOMETRYCOLLECTION(POINT EMPTY)')));
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('GEOMETRYCOLLECTION(MULTIPOINT EMPTY,POINT(1 1))')));
----
POINT(1 1)

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0),LINESTRING(1 1,2 2),POINT(3 3))')));
----
GEOMETRYCOLLECTION(MULTIPOINT((0 0),(3 3)),LINESTRING(1 1,2 2))

query T
SELECT ST_AsText(ST_ForceCollection(ST_GeomFromText('POINT Z(1 2 3)')));
----
GEOMETRYCOLLECTION Z(POINT Z(1 2 3))

query T
SELECT ST_AsText(ST_ForceCollection(ST_GeomFromText('MULTIPOINT((0 0),(1 1))')));
----
GEOMETRYCOLLECTION(POINT(0 0),POINT(1 1))

query T
SELECT ST_AsText(ST_ForceCollection(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0))')));
----
GEOMETRYCOLLECTION(POINT(0 0))

query T
SELECT ST_AsText(ST_ForceCollection(ST_GeomFromText('POINT Z EMPTY')));
----
GEOMETRYCOLLECTION Z(POINT Z EMPTY)

query T
SELECT ST_AsText(ST_Multi(ST_GeomFromText('POINT ZM(1 2 3 4)')));
----
MULTIPOINT ZM((1 2 3 4))

query T
SELECT ST_AsText(ST_Multi(ST_GeomFromText('LINESTRING(0 0,1 1)')));
----
MULTILINESTRING((0 0,1 1))

query T
SELECT ST_AsText(ST_Multi(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 0))')));
----
MULTIPOLYGON(((0 0,1 0,1 1,0 0)))

query T
SELECT ST_AsText(ST_Multi(ST_GeomFromText('MULTIPOINT((0 0),(1 1))')));
----
MULTIPOINT((0 0),(1 1))

query T
SELECT ST_AsText(ST_Multi(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0))')));
----
GEOMETRYCOLLECTION(POINT(0 0))

query T
SELECT ST_AsText(ST_Multi(ST_GeomFromText('POINT Z EMPTY')));
----
MULTIPOINT Z EMPTY

query T
SELECT ST_AsText(ST_ForcePolygonCCW(ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0),(1 1,3 1,3 3,1 3,1 1))')));
----
POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,1 3,3 3,3 1,1 1))

query T
SELECT ST_AsText(ST_ForcePolygonCW(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,1 3,3 3,3 1,1 1))')));
----
POLYGON((0 0,0 4,4 4,4 0,0 0),(1 1,3 1,3 3,1 3,1 1))

query T
SELECT ST_AsText(ST_ForceRHR(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,1 3,3 3,3 1,1 1))')));
----
POLYGON((0 0,0 4,4 4,4 0,0 0),(1 1,3 1,3 3,1 3,1 1))

query T
SELECT ST_AsText(ST_ForcePolygonCCW(ST_GeomFromText('GEOMETRYCOLLECTION(POLYGON((0 0,0 4,4 4,4 0,0 0)))')));
----
GEOMETRYCOLLECTION(POLYGON((0 0,0 4,4 4,4 0,0 0)))

query T
SELECT ST_AsText(ST_ForcePolygonCW(ST_GeomFromText('GEOMETRYCOLLECTION(POLYGON((0 0,4 0,4 4,0 4,0 0)))')));
----
GEOMETRYCOLLECTION(POLYGON((0 0,0 4,4 4,4 0,0 0)))

query T
SELECT ST_AsText(ST_ForcePolygonCCW(ST_GeomFromText('POLYGON((0 0,1 1,2 2,0 0))')));
----
POLYGON((0 0,1 1,2 2,0 0))

query T
SELECT ST_AsText(ST_ForcePolygonCW(ST_GeomFromText('POLYGON((0 0,1 1,2 2,0 0))')));
----
POLYGON((0 0,2 2,1 1,0 0))

query T
SELECT ST_AsText(ST_ForceSFS(ST_GeomFromText('POINT ZM(1 2 3 4)')));
----
POINT ZM(1 2 3 4)

query T
SELECT ST_AsText(ST_ForceSFS(ST_GeomFromText('GEOMETRYCOLLECTION Z(POINT Z(0 0 1),LINESTRING Z(1 1 1,2 2 2))')));
----
GEOMETRYCOLLECTION Z(POINT Z(0 0 1),LINESTRING Z(1 1 1,2 2 2))

query T
SELECT ST_AsText(ST_ForceSFS(ST_GeomFromText('POINT(1 2)'), '1.2'));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_ForceSFS(ST_GeomFromText('POINT(1 2)'), '9.9'));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_ForceSFS(ST_GeomFromText('POINT(1 2)'), NULL));
----
NULL

query T
SELECT ST_AsText(ST_CollectionExtract(ST_GeomFromText(NULL), 4));
----
NULL

query T
SELECT ST_AsText(ST_CollectionHomogenize(ST_GeomFromText(NULL)));
----
NULL
