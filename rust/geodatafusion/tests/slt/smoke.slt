# The public register() entry point must expose the baseline SQL functions.
query T
SELECT ST_AsText(ST_Point(1.5, -2.25));
----
POINT(1.5 -2.25)

query R
SELECT ST_Distance(ST_Point(0, 0), ST_Point(3, 4));
----
5

query R
SELECT ST_X(ST_Point(7, 8));
----
7

query R
SELECT ST_Distance(
  ST_Point(CAST(NULL AS DOUBLE), 0),
  ST_Point(0, 0)
);
----
NULL
