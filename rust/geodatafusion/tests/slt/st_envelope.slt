query TT
SELECT
  ST_GeometryType(ST_Envelope(ST_GeomFromText('LINESTRING(0 0,1 3)'))),
  ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING(0 0,1 3)')));
----
ST_Polygon POLYGON((0 0,0 3,1 3,1 0,0 0))

query TT
SELECT
  ST_GeometryType(ST_Envelope(ST_GeomFromText('POINT(1 3)'))),
  ST_AsText(ST_Envelope(ST_GeomFromText('POINT(1 3)')));
----
ST_Point POINT(1 3)

query TTT
SELECT
  ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING(1 0,1 5)'))),
  ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING(0 1,5 1)'))),
  ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING Z (1 2 3,4 5 6)')));
----
LINESTRING(1 0,1 5) LINESTRING(0 1,5 1) POLYGON((1 2,1 5,4 5,4 2,1 2))

query TT
SELECT
  ST_GeometryType(ST_Envelope(ST_GeomFromText(wkt))),
  ST_AsText(ST_Envelope(ST_GeomFromText(wkt)))
FROM (
  VALUES
    ('POINT EMPTY'),
    ('LINESTRING EMPTY'),
    ('POLYGON EMPTY'),
    ('GEOMETRYCOLLECTION(POINT EMPTY)')
) AS geometries(wkt);
----
ST_Point POINT EMPTY
ST_LineString LINESTRING EMPTY
ST_Polygon POLYGON EMPTY
ST_GeometryCollection GEOMETRYCOLLECTION EMPTY

query B
SELECT ST_Envelope(ST_GeomFromText(CAST(NULL AS TEXT))) IS NULL;
----
true

query B
SELECT ST_Envelope(NULL) IS NULL;
----
true
