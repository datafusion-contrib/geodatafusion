query R
SELECT ST_Area(ST_GeomFromText(wkt))
FROM (
  VALUES
    ('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ('POLYGON((0 0,1 0,1 1,0 1,0 0))')
) AS polygons(wkt);
----
4.0
1.0

query R
SELECT ST_Area(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,3 1,3 3,1 3,1 1))'));
----
12.0

query R
SELECT ST_Area(ST_GeomFromText('MULTIPOLYGON(((0 0,2 0,2 2,0 2,0 0)),((10 10,13 10,13 12,10 12,10 10)))'));
----
10.0

query R
SELECT ST_Area(ST_GeomFromText('LINESTRING(0 0,3 4)'));
----
0.0

query R
SELECT ST_Area(ST_GeomFromText('POLYGON EMPTY'));
----
0.0

query R
SELECT ST_Area(ST_GeomFromText(CAST(NULL AS VARCHAR)));
----
NULL
