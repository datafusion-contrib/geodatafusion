# Native geometry-processing SQL contracts.
#
# These values are the reviewed public GeoDataFusion contract. The
# native-processing PostGIS groups provide raw EWKB/Arrow comparison for the
# subset where PostGIS is the behavioral reference.

# ST_ChaikinSmoothing

query T
SELECT ST_AsText(ST_ChaikinSmoothing(ST_GeomFromText('LINESTRING(0 0,10 0,10 10)')));
----
LINESTRING(0 0,7.5 0,10 2.5,10 10)

query T
SELECT ST_AsText(ST_ChaikinSmoothing(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))'), 1, true));
----
POLYGON((0 0,7.5 0,10 2.5,10 7.5,7.5 10,2.5 10,0 7.5,0 0))

query T
SELECT ST_AsText(ST_ChaikinSmoothing(ST_GeomFromText('LINESTRING ZM (0 0 5 1,10 0 6 2,10 10 7 3)')));
----
LINESTRING ZM(0 0 5 1,7.5 0 5.75 1.75,10 2.5 6.25 2.25,10 10 7 3)

query B
SELECT ST_ChaikinSmoothing(ST_GeomFromText('POINT(1 2)'), 0) IS NULL;
----
false

query T
SELECT ST_AsText(ST_ChaikinSmoothing(NULL));
----
NULL

statement error Number of iterations must be between 1 and 5
SELECT ST_ChaikinSmoothing(ST_GeomFromText('LINESTRING(0 0,1 0,1 1)'), 0);

statement error Number of iterations must be between 1 and 5
SELECT ST_ChaikinSmoothing(ST_GeomFromText('LINESTRING(0 0,1 0,1 1)'), 6);

# ST_FilterByM

query T
SELECT ST_AsText(ST_FilterByM(ST_GeomFromText('LINESTRING M (0 0 1,1 0 2,2 0 3)'), 2, 3));
----
LINESTRING(1 0,2 0)

query T
SELECT ST_AsText(ST_FilterByM(ST_GeomFromText('LINESTRING M (0 0 1,1 0 2,2 0 3)'), 2, 3, true));
----
LINESTRING M(1 0 2,2 0 3)

query T
SELECT ST_AsText(ST_FilterByM(ST_GeomFromText('POLYGON M ((0 0 1,10 0 1,10 10 1,9 9 1,8 10 1,0 10 1,0 0 1),(2 2 5,3 2 5,3 3 5,2 3 5,2 2 5))'), 1, 3));
----
POLYGON((0 0,10 0,10 10,9 9,8 10,0 10,0 0))

query T
SELECT ST_AsText(ST_FilterByM(ST_GeomFromText('LINESTRING(0 0,1 0,2 0)'), 2, 3));
----
LINESTRING(0 0,1 0,2 0)

query B
SELECT ST_FilterByM(NULL, 1) IS NULL;
----
true

query B
SELECT ST_FilterByM(ST_GeomFromText('LINESTRING M (0 0 1,1 0 2)'), NULL, 2) IS NULL;
----
false

statement error Min-value cannot be larger than Max value
SELECT ST_FilterByM(ST_GeomFromText('LINESTRING M (0 0 1,1 0 2)'), 3, 2);

# ST_GeneratePoints

query T
SELECT ST_GeometryType(ST_GeneratePoints(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))'), 3, 42));
----
ST_MultiPoint

query I
SELECT ST_NPoints(ST_GeneratePoints(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))'), 3, 42));
----
3

query I
SELECT ST_NPoints(ST_GeneratePoints(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))'), 3, 43));
----
3

query B
SELECT ST_GeneratePoints(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'), 0, 1) IS NULL;
----
true

query B
SELECT ST_GeneratePoints(NULL, 1) IS NULL;
----
true

query B
SELECT ST_GeneratePoints(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'), 1, NULL) IS NULL;
----
true

statement error seed must be greater than zero
SELECT ST_GeneratePoints(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'), 1, 0);

statement error unsupported geometry type 'Point'
SELECT ST_GeneratePoints(ST_GeomFromText('POINT(1 2)'), 2, 1);

# ST_GeometricMedian

query T
SELECT ST_AsText(ST_GeometricMedian(ST_GeomFromText('MULTIPOINT((0 0),(10 0),(10 10),(0 10))')));
----
POINT(5 5)

query T
SELECT ST_AsText(ST_GeometricMedian(ST_GeomFromText('MULTIPOINT M ((0 0 1),(10 0 1),(10 10 1),(0 10 100))')));
----
POINT(0.00000006724142017052579 9.999999932758579)

query T
SELECT ST_AsText(ST_GeometricMedian(ST_GeomFromText('POINT M (1 2 3)')));
----
POINT M(1 2 3)

query T
SELECT ST_AsText(ST_GeometricMedian(ST_GeomFromText('MULTIPOINT EMPTY')));
----
POINT EMPTY

query B
SELECT ST_GeometricMedian(NULL) IS NULL;
----
true

statement error Unsupported geometry type: LineString
SELECT ST_GeometricMedian(ST_GeomFromText('LINESTRING(0 0,1 1)'));

statement error Tolerance must be positive
SELECT ST_GeometricMedian(ST_GeomFromText('MULTIPOINT((0 0),(10 0))'), -1);

statement error Maximum iterations must be positive
SELECT ST_GeometricMedian(ST_GeomFromText('MULTIPOINT((0 0),(10 0))'), NULL, NULL);

# ST_SetEffectiveArea

query T
SELECT ST_AsText(ST_SetEffectiveArea(ST_GeomFromText('LINESTRING(0 0,1 0,2 0.1,3 0,4 0)'), -1, 0));
----
LINESTRING(0 0,1 0,2 0.1,3 0,4 0)

query I
SELECT ST_NPoints(ST_SetEffectiveArea(ST_GeomFromText('LINESTRING(5 2,3 8,6 20,7 25,10 10)'), 30));
----
3

query T
SELECT ST_AsText(ST_SetEffectiveArea(ST_GeomFromText('POINT(1 2)')));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_SetEffectiveArea(ST_GeomFromText('LINESTRING EMPTY')));
----
LINESTRING EMPTY

query B
SELECT ST_SetEffectiveArea(NULL) IS NULL;
----
true

query B
SELECT ST_SetEffectiveArea(ST_GeomFromText('LINESTRING(0 0,1 0,2 0.1)'), NULL) IS NULL;
----
true

# ST_Letters

query T
SELECT ST_GeometryType(ST_Letters('A'));
----
ST_MultiPolygon

query B
SELECT ST_NPoints(ST_Letters('A')) > 0;
----
true

query B
SELECT ST_Letters('') IS NULL;
----
true

query B
SELECT ST_Letters(NULL) IS NULL;
----
true

query B
SELECT ST_Letters('A', '{}') IS NULL;
----
true

statement error font is not valid JSON
SELECT ST_Letters('A', 'not-json');

statement error ST_GeomFromTWKB encountered unknown TWKB type 0
SELECT ST_Letters('A', '{"m":"AAAA","A":"AAAA"}');

statement error invalid base64
SELECT ST_Letters('A', '{"m":"not-base64","A":"not-base64"}');

# Multi-row public execution.

query T
SELECT ST_AsText(ST_ChaikinSmoothing(ST_GeomFromText(wkt)))
FROM (VALUES ('LINESTRING(0 0,1 0,1 1)'), ('LINESTRING(0 0,2 0,2 2)')) AS t(wkt);
----
LINESTRING(0 0,0.75 0,1 0.25,1 1)
LINESTRING(0 0,1.5 0,2 0.5,2 2)
