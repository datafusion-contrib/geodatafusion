query R
SELECT ST_Length(ST_GeomFromText('LINESTRING Z (0 0 0,3 4 100)'));
----
5.0

query R
SELECT ST_Length2D(ST_GeomFromText('LINESTRING Z (0 0 0,3 4 100)'));
----
5.0

query R
SELECT ST_Length(ST_GeomFromText('MULTILINESTRING((0 0,3 4),(10 10,10 14))'));
----
9.0

query R
SELECT ST_Length(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'));
----
0.0

query R
SELECT ST_Length(ST_GeomFromText('LINESTRING EMPTY'));
----
0.0

query R
SELECT ST_Length(ST_GeomFromText(CAST(NULL AS VARCHAR)));
----
NULL
