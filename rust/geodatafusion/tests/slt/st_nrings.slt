0

query I
SELECT ST_NRings(
  ST_GeomFromWKB(
    ST_AsBinary(ST_GeomFromText(
      'MULTIPOLYGON(((0 0,0 5,5 5,0 0)),((10 10,10 15,15 15,10 10),(11 11,11 12,12 12,11 11)))'
    ))
  )
);
----
3

query I
SELECT ST_NRings(ST_GeomFromText(wkt))
FROM (
  VALUES
    ('POLYGON((0 0,0 5,5 5,0 0))'),
    (NULL)
) AS geometries(wkt);
----
1
