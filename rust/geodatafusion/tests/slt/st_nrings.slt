query I
SELECT ST_NRings(ST_GeomFromText(wkt))
FROM (
  VALUES
    ('POLYGON((0 0,0 5,5 5,5 0,0 0))'),
    ('POLYGON((0 0,0 10,10 10,10 0,0 0),(1 1,1 2,2 2,1 1),(7 7,7 8,8 8,7 7))'),
    ('POLYGON EMPTY'),
    ('MULTIPOLYGON EMPTY'),
    ('MULTIPOLYGON(((0 0,0 5,5 5,0 0)),((10 10,10 15,15 15,10 10),(11 11,11 12,12 12,11 11)))'),
    ('GEOMETRYCOLLECTION(POLYGON((0 0,0 5,5 5,0 0)),MULTIPOLYGON(((10 10,10 15,15 15,10 10))))'),
    ('GEOMETRYCOLLECTION(POLYGON EMPTY,LINESTRING EMPTY)'),
    ('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POLYGON EMPTY))'),
    ('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POLYGON((0 0,0 5,5 5,0 0))))'),
    ('POINT(1 2)'),
    ('LINESTRING(0 0,1 1)'),
    ('MULTIPOINT((1 2))'),
    ('MULTILINESTRING((0 0,1 1))')
) AS geometries(wkt);
----
1
3
0
0
3
2
0
0
1
0
0
