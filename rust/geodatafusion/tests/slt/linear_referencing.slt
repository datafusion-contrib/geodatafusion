query B
SELECT ST_LineLocatePoint(
    ST_GeomFromText('LINESTRING(0 0,10 0)'),
    NULL
) IS NULL;
----
true

query B
SELECT ST_InterpolatePoint(
    ST_GeomFromText('LINESTRING M (0 0 0,10 0 10)'),
    NULL
) IS NULL;
----
true

query T
SELECT ST_AsText(
    ST_LineSubstring(ST_GeomFromText('LINESTRING Z (0 0 0,0 0 10)'), 0.2, 0.8)
);
----
POINT Z(0 0 10)

query T
SELECT ST_AsText(
    ST_LineSubstring(
        ST_GeomFromText('LINESTRING Z (0 0 0,0 0 1,0 0 2)'),
        0.2,
        0.8
    )
);
----
LINESTRING Z(0 0 1,0 0 2)

statement error line_interpolate_point: 2nd arg isn't within
SELECT ST_LineInterpolatePoint(ST_GeomFromText('LINESTRING(0 0,10 0)'), 1.5);

statement error 2nd arg must be smaller then 3rd arg
SELECT ST_LineSubstring(ST_GeomFromText('LINESTRING(0 0,10 0)'), 0.75, 0.25);

statement error Only linear geometries are supported
SELECT ST_LocateBetween(
    ST_GeomFromText('POLYGON M ((0 0 0,4 0 4,4 4 8,0 4 4,0 0 0))'),
    4,
    4
);

statement error unexpected type
SELECT ST_LocateBetween(
    ST_GeomFromText('POLYGON M ((0 0 0,4 0 4,4 4 8,0 4 4,0 0 0))'),
    2,
    6,
    2
);
