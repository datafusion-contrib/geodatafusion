true

query B
SELECT ST_LocateAlong(
    ST_GeomFromText('LINESTRING M (0 0 0,10 0 10)'),
    NULL
) IS NULL;
----
true

query B
SELECT ST_LocateBetween(
    ST_GeomFromText('LINESTRING M (0 0 0,10 0 10)'),
    NULL,
    5
) IS NULL;
----
true

