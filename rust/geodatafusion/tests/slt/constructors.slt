# Point constructor SQL contracts.

query T
SELECT ST_AsText(ST_MakePoint(1, 2));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_MakePoint(1, 2, 3));
----
POINT Z(1 2 3)

query T
SELECT ST_AsText(ST_MakePoint(1, 2, 3, 4));
----
POINT ZM(1 2 3 4)

query T
SELECT ST_AsText(ST_MakePointM(1, 2, 3));
----
POINT M(1 2 3)

query T
SELECT ST_AsText(ST_Point(1, 2));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_PointZ(1, 2, 3));
----
POINT Z(1 2 3)

query T
SELECT ST_AsText(ST_PointM(1, 2, 3));
----
POINT M(1 2 3)

query T
SELECT ST_AsText(ST_PointZM(1, 2, 3, 4));
----
POINT ZM(1 2 3 4)

query T
SELECT ST_AsText(ST_MakePoint(NULL, 1));
----
NULL

query T
SELECT ST_AsText(ST_MakePoint(x, y))
FROM (
    SELECT CAST(0 AS DOUBLE) AS x, CAST(0 AS DOUBLE) AS y
    UNION ALL
    SELECT CAST(1 AS DOUBLE), CAST(2 AS DOUBLE)
) AS t
ORDER BY x;
----
POINT(0 0)
POINT(1 2)

query T
SELECT ST_AsText(ST_LineFromMultiPoint(
    ST_GeomFromText('MULTIPOINT(0 0,1 1,2 3)')
));
----
LINESTRING(0 0,1 1,2 3)

query T
SELECT ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT EMPTY')));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_MakeLine(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 1)')
));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_MakeLine(
    ST_GeomFromText('LINESTRING(0 0,1 1)'),
    ST_GeomFromText('LINESTRING(1 1,2 2)')
));
----
LINESTRING(0 0,1 1,2 2)

query T
SELECT ST_AsText(ST_MakeLine(
    ST_GeomFromText('POINT(3 4)'),
    ST_GeomFromText(NULL)
));
----
NULL

query T
SELECT ST_AsText(ST_MakeLine(
    ST_PointFromText('POINT(0 0)', 4326),
    ST_PointFromText('POINT(1 1)', 4326)
));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_MakePolygon(
    ST_GeomFromText('LINESTRING(0 0,0 4,4 4,4 0,0 0)')
));
----
POLYGON((0 0,0 4,4 4,4 0,0 0))

query T
SELECT ST_AsText(ST_Polygon(
    ST_GeomFromText('LINESTRING(0 0,0 4,4 4,4 0,0 0)'),
    4326
));
----
POLYGON((0 0,0 4,4 4,4 0,0 0))

query T
SELECT ST_AsText(ST_MakePolygon(ST_GeomFromText(NULL)));
----
NULL

query T
SELECT ST_AsText(ST_MakeEnvelope(0, 0, 10, 5));
----
POLYGON((0 0,0 5,10 5,10 0,0 0))

query T
SELECT ST_AsText(ST_MakeEnvelope(0, 0, 10, 5, 4326));
----
POLYGON((0 0,0 5,10 5,10 0,0 0))

query T
SELECT ST_AsText(ST_MakeEnvelope(NULL, 0, 10, 5, 4326));
----
NULL

query T
SELECT ST_AsText(ST_TileEnvelope(0, 0, 0));
----
POLYGON((-20037508.342789244 -20037508.342789244,-20037508.342789244 20037508.342789244,20037508.342789244 20037508.342789244,20037508.342789244 -20037508.342789244,-20037508.342789244 -20037508.342789244))

query T
SELECT ST_AsText(ST_TileEnvelope(2, 1, 1, 0.1));
----
POLYGON((-11020629.588534083 -1001875.4171394631,-11020629.588534083 11020629.588534083,1001875.4171394631 11020629.588534083,1001875.4171394631 -1001875.4171394631,-11020629.588534083 -1001875.4171394631))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, CAST(NULL AS DOUBLE)));
----
NULL

statement error must be closed
SELECT ST_MakePolygon(ST_GeomFromText('LINESTRING(0 0,0 1,1 1,1 0)'));

statement error Point or LineString
SELECT ST_MakeLine(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POLYGON((0 0,0 1,1 1,0 0))')
);

statement error mixed-dimensional
SELECT ST_MakeLine(
    ST_GeomFromText('LINESTRING(0 0,1 1)'),
    ST_GeomFromText('LINESTRING Z (1 1 2,2 2 3)')
);

statement error invalid tile zoom value
SELECT ST_TileEnvelope(32, 0, 0);

query B
SELECT ST_MakePolygon(NULL) IS NULL;
----
true

query B
SELECT ST_LineFromMultiPoint(NULL) IS NULL;
----
true

query B
SELECT ST_MakeLine(NULL, NULL) IS NULL;
----
true

query B
SELECT ST_Polygon(NULL, 0) IS NULL;
----
true

query B
SELECT ST_MakePolygon(
    ST_GeomFromText('LINESTRING(0 0,0 1,1 1,0 0)'),
    NULL
) IS NULL;
----
true

query T
SELECT ST_AsText(ST_MakePolygon(NULL));
----
NULL

query T
SELECT ST_AsText(ST_LineFromMultiPoint(NULL));
----
NULL

query T
SELECT ST_AsText(ST_MakeLine(NULL, NULL));
----
NULL

query T
SELECT ST_AsText(ST_Polygon(NULL, 0));
----
NULL

query B
SELECT ST_MakePolygon(ST_GeomFromText(NULL)) IS NULL;
----
true

query B
SELECT ST_MakeEnvelope(0, 0, 1, 1, NULL) IS NULL;
----
true

query B
SELECT ST_TileEnvelope(0, 0, 0, CAST(NULL AS DOUBLE)) IS NULL;
----
true

query B
SELECT ST_Polygon(
    ST_GeomFromText('LINESTRING(0 0,0 1,1 1,0 0)'),
    NULL
) IS NULL;
----
true
