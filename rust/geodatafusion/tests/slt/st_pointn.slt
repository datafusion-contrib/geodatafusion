query TTT
SELECT
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING ZM(0 0 1 2,1 1 3 4,2 2 5 6)'), 1)),
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING ZM(0 0 1 2,1 1 3 4,2 2 5 6)'), -1)),
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING ZM(0 0 1 2,1 1 3 4,2 2 5 6)'), -2))
;
----
POINT ZM(0 0 1 2) POINT ZM(2 2 5 6) POINT ZM(1 1 3 4)

query TTTTT
SELECT
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING(0 0,1 1)'), 0)),
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING(0 0,1 1)'), 3)),
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING(0 0,1 1)'), -3)),
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING EMPTY'), 1)),
  ST_AsText(ST_PointN(ST_GeomFromText('MULTILINESTRING((0 0,1 1))'), 1))
;
----
NULL NULL NULL NULL NULL

query TT
SELECT
  ST_AsText(ST_PointN(NULL, 1)),
  ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING(0 0,1 1)'), NULL))
;
----
NULL NULL
