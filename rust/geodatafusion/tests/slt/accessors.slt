# Geometry attribute accessor SQL contracts.
#
# References: the PostGIS manual (`reference_accessor.xml`) and
# `regress/core/empty.sql`, `regress/core/iscollection.sql`, and
# `regress/core/regress_ogc.sql` at postgis/postgis commit 80fc3d3. The
# reviewed PostGIS 3.6 answers are also checked into
# `tests/postgis/accessors/{attributes,point_coordinates,start_end,empty_and_closed,counts}`.

# GeometryType, ST_GeometryType, ST_CoordDim, and ST_NDims share one matrix.
query TTII
SELECT GeometryType(g), ST_GeometryType(g), ST_CoordDim(g), ST_NDims(g)
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g
    FROM (VALUES
        (1, 'POINT(1 2)'),
        (2, 'POINT Z (1 2 3)'),
        (3, 'POINT M (1 2 3)'),
        (4, 'POINT ZM (1 2 3 4)'),
        (5, 'LINESTRING Z (0 0 1,1 1 2)'),
        (6, 'LINESTRING M (0 0 1,1 1 2)'),
        (7, 'MULTIPOINT M ((1 2 3),(3 4 5))'),
        (8, 'POLYGON M ((0 0 1,4 0 2,4 4 3,0 0 1))'),
        (9, 'GEOMETRYCOLLECTION Z (POINT Z (1 2 3))'),
        (10, 'POINT EMPTY'),
        (11, 'POINT M EMPTY'),
        (12, 'POINT ZM EMPTY'),
        (13, 'LINESTRING EMPTY'),
        (14, 'POLYGON EMPTY'),
        (15, 'GEOMETRYCOLLECTION EMPTY'),
        (16, NULL)
    ) AS inputs(id, wkt)
) AS t
ORDER BY id;
----
POINT ST_Point 2 2
POINT ST_Point 3 3
POINTM ST_Point 3 3
POINT ST_Point 4 4
LINESTRING ST_LineString 3 3
LINESTRINGM ST_LineString 3 3
MULTIPOINTM ST_MultiPoint 3 3
POLYGONM ST_Polygon 3 3
GEOMETRYCOLLECTION ST_GeometryCollection 3 3
POINT ST_Point 2 2
POINTM ST_Point 3 3
POINT ST_Point 4 4
LINESTRING ST_LineString 2 2
POLYGON ST_Polygon 2 2
GEOMETRYCOLLECTION ST_GeometryCollection 2 2
NULL NULL NULL NULL

# ST_X, ST_Y, ST_Z, and ST_M read the POINT ordinates; EMPTY and NULL are NULL.
query RRRR
SELECT ST_X(g), ST_Y(g), ST_Z(g), ST_M(g)
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g
    FROM (VALUES
        (1, 'POINT(1 2)'),
        (2, 'POINT Z (1 2 3)'),
        (3, 'POINT M (1 2 3)'),
        (4, 'POINT ZM (1 2 3 4)'),
        (5, 'POINT EMPTY'),
        (6, 'POINT M EMPTY'),
        (7, 'POINT ZM EMPTY'),
        (8, NULL)
    ) AS inputs(id, wkt)
) AS t
ORDER BY id;
----
1 2 NULL NULL
1 2 3 NULL
1 2 NULL 3
1 2 3 4
NULL NULL NULL NULL
NULL NULL NULL NULL
NULL NULL NULL NULL
NULL NULL NULL NULL

# Only POINT input has ordinates; PostGIS raises for every other type.
statement error Argument to st_x\(\) must have type POINT
SELECT ST_X(ST_GeomFromText('LINESTRING(0 0,1 1)'));

statement error Argument to st_m\(\) must have type POINT
SELECT ST_M(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 0))'));

# ST_StartPoint uses the first point in element order; ST_EndPoint is LineString-only.
query TT
SELECT ST_AsText(ST_StartPoint(g)), ST_AsText(ST_EndPoint(g))
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g
    FROM (VALUES
        (1, 'POINT(1 2)'),
        (2, 'LINESTRING(0 0,1 1,2 2)'),
        (3, 'LINESTRING Z (0 0 1,1 1 2)'),
        (4, 'LINESTRING M (0 0 1,1 1 2)'),
        (5, 'LINESTRING ZM (0 0 1 2,1 1 3 4)'),
        (6, 'POLYGON((0 0,4 0,4 4,0 4,0 0))'),
        (7, 'MULTIPOINT((1 2),(3 4))'),
        (8, 'MULTILINESTRING((0 0,1 1),(2 2,3 3))'),
        (9, 'MULTIPOLYGON(((0 0,1 0,1 1,0 0)))'),
        (10, 'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'),
        (11, 'POINT EMPTY'),
        (12, 'LINESTRING EMPTY'),
        (13, 'MULTIPOINT(EMPTY,(3 4))'),
        (14, 'GEOMETRYCOLLECTION(POINT EMPTY,LINESTRING(0 0,1 1))'),
        (15, 'MULTILINESTRING EMPTY'),
        (16, NULL)
    ) AS inputs(id, wkt)
) AS t
ORDER BY id;
----
POINT(1 2) NULL
POINT(0 0) POINT(2 2)
POINT Z(0 0 1) POINT Z(1 1 2)
POINT M(0 0 1) POINT M(1 1 2)
POINT ZM(0 0 1 2) POINT ZM(1 1 3 4)
POINT(0 0) NULL
POINT(1 2) NULL
POINT(0 0) NULL
POINT(0 0) NULL
POINT(1 2) NULL
NULL NULL
NULL NULL
NULL NULL
NULL NULL
NULL NULL
NULL NULL

# ST_IsEmpty is recursive; ST_IsClosed requires non-empty, fully closed input.
query BB
SELECT ST_IsEmpty(g), ST_IsClosed(g)
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g
    FROM (VALUES
        (1, 'POINT(0 0)'),
        (2, 'POINT EMPTY'),
        (3, 'LINESTRING(0 0,1 1,0 0)'),
        (4, 'LINESTRING(0 0,1 1)'),
        (5, 'LINESTRING EMPTY'),
        (6, 'MULTILINESTRING((0 0,1 1,0 0),(2 2,3 3,2 2))'),
        (7, 'MULTILINESTRING((0 0,1 1,0 0),(2 2,3 3,2 3))'),
        (8, 'MULTILINESTRING(EMPTY,(2 2,3 3,2 2))'),
        (9, 'MULTILINESTRING EMPTY'),
        (10, 'POLYGON((0 0,1 0,1 1,0 0))'),
        (11, 'POLYGON EMPTY'),
        (12, 'MULTIPOINT((1 2),(3 4))'),
        (13, 'MULTIPOINT(EMPTY,(3 4))'),
        (14, 'MULTIPOINT EMPTY'),
        (15, 'MULTIPOLYGON(((0 0,1 0,1 1,0 0)))'),
        (16, 'MULTIPOLYGON(EMPTY,((0 0,1 0,1 1,0 0)))'),
        (17, 'MULTIPOLYGON EMPTY'),
        (18, 'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1,0 0))'),
        (19, 'GEOMETRYCOLLECTION(POINT EMPTY,LINESTRING(0 0,1 1,0 0))'),
        (20, 'GEOMETRYCOLLECTION EMPTY'),
        (21, 'GEOMETRYCOLLECTION(POINT EMPTY,POLYGON EMPTY)'),
        (22, NULL)
    ) AS inputs(id, wkt)
) AS t
ORDER BY id;
----
false true
true false
false true
false false
true false
false true
false false
false false
true false
false true
true false
false true
false false
true false
false true
false false
true false
false true
false false
true false
true false
NULL NULL

# ST_NPoints counts vertices everywhere; ST_NumPoints/ST_NumInteriorRings are
# restricted to LINESTRING and POLYGON and are NULL otherwise.
query IIII
SELECT ST_NPoints(g), ST_NumPoints(g), ST_NumInteriorRings(g), ST_NumInteriorRing(g)
FROM (
    SELECT id, ST_GeomFromText(wkt) AS g
    FROM (VALUES
        (1, 'POINT(1 2)'),
        (2, 'POINT EMPTY'),
        (3, 'LINESTRING(0 0,1 1,2 0)'),
        (4, 'LINESTRING EMPTY'),
        (5, 'POLYGON((0 0,4 0,4 4,0 4,0 0))'),
        (6, 'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'),
        (7, 'POLYGON EMPTY'),
        (8, 'MULTIPOINT((1 2),(3 4))'),
        (9, 'MULTIPOINT(EMPTY,(3 4))'),
        (10, 'MULTILINESTRING((0 0,1 1),(2 2,3 3))'),
        (11, 'MULTILINESTRING(EMPTY,(2 2,3 3,2 2))'),
        (12, 'MULTIPOLYGON(((0 0,1 0,1 1,0 0)))'),
        (13, 'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'),
        (14, 'GEOMETRYCOLLECTION EMPTY'),
        (15, NULL)
    ) AS inputs(id, wkt)
) AS t
ORDER BY id;
----
1 NULL NULL NULL
0 NULL NULL NULL
3 3 NULL NULL
0 0 NULL NULL
5 NULL 0 0
10 NULL 1 1
0 NULL 0 0
2 NULL NULL NULL
1 NULL NULL NULL
4 NULL NULL NULL
3 NULL NULL NULL
4 NULL NULL NULL
3 NULL NULL NULL
0 NULL NULL NULL
NULL NULL NULL NULL
