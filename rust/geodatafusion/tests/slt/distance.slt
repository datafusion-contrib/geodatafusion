# ST_Distance planar measurement contracts.

query R
SELECT ST_Distance(ST_Point(0, 0), ST_Point(3, 4));
----
5

query R
SELECT ST_Distance(
    ST_GeomFromText('POINT(-72.1235 42.3521)'),
    ST_GeomFromText('LINESTRING(-72.1260 42.45, -72.123 42.1546)')
);
----
0.001505677264

query R
SELECT ST_Distance(ST_GeomFromText(NULL), ST_Point(0, 0));
----
NULL

query R
SELECT ST_Distance(ST_Point(0, 0), ST_Point(x, y))
FROM (
    SELECT CAST(0 AS DOUBLE) AS x, CAST(0 AS DOUBLE) AS y
    UNION ALL
    SELECT CAST(3 AS DOUBLE), CAST(4 AS DOUBLE)
) AS t
ORDER BY x;
----
0
5
