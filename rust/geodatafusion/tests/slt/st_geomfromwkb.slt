query T
SELECT ST_AsText(ST_GeomFromWKB(ST_AsBinary(ST_Point(1, 2))));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_WKBToSQL(ST_AsBinary(ST_Point(3, 4))));
----
POINT(3 4)

query TT
SELECT
  ST_GeometryType(ST_GeomFromWKB(X'010700000001000000010100000000000000000008400000000000001040')),
  ST_AsText(ST_GeomFromWKB(X'010700000001000000010100000000000000000008400000000000001040'));
----
ST_GeometryCollection GEOMETRYCOLLECTION(POINT(3 4))
