query RR
SELECT
  ST_Area(ST_ConcaveHull(ST_GeomFromText('MULTIPOINT((0 0),(3 0),(1 2),(0 4))'), 1)),
  ST_Area(ST_ConcaveHull(ST_GeomFromText('MULTIPOINT((0 0),(3 0),(1 2),(0 4))'), 0.1));
----
6.0 5.0

query B
SELECT ST_Equals(
  ST_ConcaveHull(ST_GeomFromText('MULTIPOINT((0 0),(3 0),(1 2),(0 4))'), 0.1),
  ST_GeomFromText('POLYGON((0 0,0 4,1 2,3 0,0 0))')
);
----
true

query T
SELECT ST_AsText(ST_ConcaveHull(
  ST_GeomFromText('MULTIPOINT((0 0),(3 0),(1 2),(0 4))'),
  CAST(1 AS INTEGER)
));
----
POLYGON((3 0,0 4,0 0,3 0))

query TT
SELECT
  ST_AsText(ST_ConcaveHull(ST_GeomFromText('MULTIPOINT((1 2),(1 2))'), 0.5)),
  ST_AsText(ST_ConcaveHull(ST_GeomFromText('MULTIPOINT((0 0),(1 1),(2 2))'), 0.5));
----
POINT(1 2) LINESTRING(0 0,2 2)

query RR
SELECT
  ST_Area(ST_ConcaveHull(
    ST_GeomFromText('POLYGON((0 0,0 10,10 10,10 0,0 0),(4 4,4 6,6 6,6 4,4 4))'),
    0.5,
    true
  )),
  ST_Area(ST_ConcaveHull(
    ST_GeomFromText('POLYGON((0 0,0 10,10 10,10 0,0 0),(4 4,4 6,6 6,6 4,4 4))'),
    0.5,
    false
  ));
----
96.0 100.0

query TT
SELECT
  ST_AsText(ST_ConcaveHull(ST_GeomFromText('POINT EMPTY'), 0.5)),
  ST_AsText(ST_ConcaveHull(ST_GeomFromText('LINESTRING EMPTY'), 0.5));
----
POINT EMPTY LINESTRING EMPTY

query TT
SELECT
  ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('MULTIPOINT Z ((0 0 1),(1 0 2),(0 1 3),(1 1 4))'),
    0.5
  )),
  ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('MULTIPOINT M ((0 0 1),(1 0 2),(0 1 3),(1 1 4))'),
    0.5
  ));
----
POLYGON Z((1 0 2,1 1 4,0 1 3,0 0 1,1 0 2)) POLYGON((1 0,1 1,0 1,0 0,1 0))

query BBBB
SELECT
  ST_ConcaveHull(NULL, 0.5) IS NULL,
  ST_ConcaveHull(ST_GeomFromText(CAST(NULL AS TEXT)), 0.5) IS NULL,
  ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), CAST(NULL AS DOUBLE)) IS NULL,
  ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), 0.5, CAST(NULL AS BOOLEAN)) IS NULL;
----
true true true true

statement error
SELECT ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), -0.1);

statement error
SELECT ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), 1.1);
