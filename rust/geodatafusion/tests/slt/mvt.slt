# ST_AsMVT SQL contract.

query B
SELECT octet_length(encode(ST_AsMVT(row, 'layer', 4096, 'geom', 'id'), 'hex')) > 0
FROM (
    SELECT named_struct('id', 1, 'name', 'a', 'geom', ST_GeomFromText('POINT(1 2)')) AS row
    UNION ALL
    SELECT named_struct('id', 2, 'name', 'b', 'geom', ST_GeomFromText('LINESTRING(0 0,1 1)')) AS row
) t;
----
true

query B
SELECT octet_length(encode(ST_AsMVT(row, 'layer'), 'hex')) > 0
FROM (
    SELECT named_struct('geom', ST_GeomFromText('POINT EMPTY')) AS row
) t;
----
true

query I
SELECT octet_length(encode(ST_AsMVT(row, 'layer'), 'hex'))
FROM (
    SELECT named_struct('geom', ST_GeomFromText('POINT(1 2)')) AS row
    WHERE false
) t;
----
0

statement error no geometry column found
SELECT ST_AsMVT(named_struct('id', 1, 'geom2', ST_Point(1, 2)), 'layer', 4096, 'geom');

statement error feature id column
SELECT ST_AsMVT(named_struct('id', 1.5, 'geom', ST_Point(1, 2)), 'layer', 4096, 'geom', 'id');
