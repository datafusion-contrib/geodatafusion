# ST_3DExtent aggregate basics.

query RRRRRR
SELECT e.xmin, e.ymin, e.zmin, e.xmax, e.ymax, e.zmax
FROM (
    SELECT ST_3DExtent(ST_GeomFromText(wkt)) AS e
    FROM (VALUES ('POINT Z(1 2 3)'), ('POINT(4 5)')) AS input(wkt)
) AS aggregate;
----
1 2 0 4 5 3

query RRRRRR
SELECT e.xmin, e.ymin, e.zmin, e.xmax, e.ymax, e.zmax
FROM (
    SELECT ST_3DExtent(ST_GeomFromText(wkt)) AS e
    FROM (VALUES ('POINT M(1 2 99)'), ('POINT M(3 4 5)')) AS input(wkt)
) AS aggregate;
----
1 2 0 3 4 0

query RRRRRR
SELECT e.xmin, e.ymin, e.zmin, e.xmax, e.ymax, e.zmax
FROM (
    SELECT ST_3DExtent(ST_GeomFromText(wkt)) AS e
    FROM (VALUES ('POINT ZM(1 2 3 99)'), ('POINT ZM(3 4 5 6)')) AS input(wkt)
) AS aggregate;
----
1 2 3 3 4 5

query RRRRRR
SELECT e.xmin, e.ymin, e.zmin, e.xmax, e.ymax, e.zmax
FROM (
    SELECT ST_3DExtent(ST_GeomFromText(wkt)) AS e
    FROM (VALUES ('POINT EMPTY'), (NULL)) AS input(wkt)
) AS aggregate;
----
NULL NULL NULL NULL NULL NULL

query IRRRRRR
SELECT g, e.xmin, e.ymin, e.zmin, e.xmax, e.ymax, e.zmax
FROM (
    SELECT g, ST_3DExtent(ST_GeomFromText(wkt)) AS e
    FROM (
        VALUES
            (1, 'POINT Z(1 2 3)'),
            (1, 'POINT(4 5)'),
            (2, 'LINESTRING M(10 20 100,30 40 5)')
    ) AS input(g, wkt)
    GROUP BY g
) AS aggregate
ORDER BY g;
----
1 1 2 0 4 5 3
2 10 20 0 30 40 0

query RRRRRR
SELECT e.xmin, e.ymin, e.zmin, e.xmax, e.ymax, e.zmax
FROM (SELECT ST_3DExtent(NULL) AS e) AS aggregate;
----
NULL NULL NULL NULL NULL NULL
