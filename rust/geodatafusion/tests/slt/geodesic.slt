# Geodesic measurement contracts.

query R
SELECT ST_DistanceSphere(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 0)')
);
----
111195.079734631581

query R
SELECT ST_DistanceSphere(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 0)'),
    6371000.0
);
----
111194.926644558742

query R
SELECT ST_DistanceSphere(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 0)'),
    -6371008.771415059
);
----
-111195.079734631581

query R
SELECT ST_DistanceSphere(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 0)'),
    CAST('NaN' AS DOUBLE)
);
----
NaN

query R
SELECT ST_DistanceSpheroid(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 0)')
);
----
111319.490793273566

query R
SELECT ST_DistanceSpheroid(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 0)'),
    'SPHEROID["WGS 84",6378137,298.257223563]'
);
----
111319.490793273566

query R
SELECT ST_LengthSpheroid(
    ST_GeomFromText('LINESTRING(0 0, 0 1)'),
    'SPHEROID["WGS 84",6378137,298.257223563]'
);
----
110574.388557798782

