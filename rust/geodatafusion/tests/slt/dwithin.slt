# ST_DWithin scalar, NULL, and error contracts.

query B
SELECT ST_DWithin(ST_Point(0, 0), ST_Point(3, 4), 5);
----
true

query B
SELECT ST_DWithin(ST_Point(0, 0), ST_Point(3, 4), 4);
----
false

query B
SELECT ST_DWithin(ST_Point(0, 0), ST_Point(0, 0), 0);
----
true

query B
SELECT ST_DWithin(ST_GeomFromText(NULL), ST_Point(0, 0), 1);
----
NULL

query B
SELECT ST_DWithin(ST_GeomFromText('POINT EMPTY'), ST_Point(0, 0), 1);
----
false

statement error finite and non-negative
SELECT ST_DWithin(ST_Point(0, 0), ST_Point(3, 4), -1);
