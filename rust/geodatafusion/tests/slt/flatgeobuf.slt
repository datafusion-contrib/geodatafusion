query TTT
SELECT CAST(id AS VARCHAR) AS id_text, name, ST_AsEWKT(geom) AS geom_text
FROM st_fromflatgeobuf(decode('', 'hex'))
ORDER BY id_text
----
1 point SRID=4326;POINT(1 2)
2 NULL NULL
3 null-geom NULL

query I
SELECT COUNT(*)
FROM st_fromflatgeobuftotable('public', 'fgb_slt', decode('', 'hex'))
----
3

query TT
SELECT CAST(id AS VARCHAR) AS id_text, name FROM fgb_slt ORDER BY id_text
----
1 point
2 NULL
3 null-geom

# Typed GeoArrow WKB is decoded to a native geometry before FlatGeobuf encoding.
query I
SELECT length(encode(ST_AsFlatGeobuf(ST_AsBinary(ST_PointFromText('POINT(1 2)', 4326))), 'hex'))
----
352

query T
SELECT ST_AsEWKT(geom)
FROM st_fromflatgeobuf(decode('', 'hex'))
----
SRID=4326;POINT(1 2)

statement error mixed geometry types are not supported
SELECT ST_AsFlatGeobuf(ST_AsBinary(ST_GeomFromText(wkt)))
FROM (VALUES ('POINT(1 2)'), ('LINESTRING(0 0,1 1)')) AS t(wkt)
