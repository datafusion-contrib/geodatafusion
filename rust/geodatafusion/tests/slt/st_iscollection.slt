query BBBBBB
SELECT
  ST_IsCollection(ST_GeomFromText('POINT(1 2)')),
  ST_IsCollection(ST_GeomFromText('LINESTRING(0 0,1 1)')),
  ST_IsCollection(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 0))')),
  ST_IsCollection(ST_GeomFromText('MULTIPOINT(1 2)')),
  ST_IsCollection(ST_GeomFromText('MULTILINESTRING((0 0,1 1))')),
  ST_IsCollection(ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 0)))'));
----
false false false true true true

query BBBBB
SELECT
  ST_IsCollection(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))')),
  ST_IsCollection(ST_GeomFromText('MULTIPOINT EMPTY')),
  ST_IsCollection(ST_GeomFromText('MULTILINESTRING EMPTY')),
  ST_IsCollection(ST_GeomFromText('MULTIPOLYGON EMPTY')),
  ST_IsCollection(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY'));
----
true true true true true

