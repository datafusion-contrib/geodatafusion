query BBBB
SELECT
  ST_HasM(ST_GeomFromText('POINT(1 2)')),
  ST_HasM(ST_GeomFromText('POINT Z(1 2 3)')),
  ST_HasM(ST_GeomFromText('POINT M(1 2 4)')),
  ST_HasM(ST_GeomFromText('POINT ZM(1 2 3 4)'));
----
false false true true

query BBBB
