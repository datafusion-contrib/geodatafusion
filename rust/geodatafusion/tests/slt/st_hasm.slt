query BB
SELECT
  ST_HasM(ST_GeomFromText('GEOMETRYCOLLECTION M(POINT M(1 2 4))')),
  ST_HasM(ST_GeomFromText('GEOMETRYCOLLECTION Z(POINT Z(1 2 3))'));
----
true false

