# ST_MakeLine contracts.
#
# PostGIS exposes ST_MakeLine as an aggregate over geometry rows and as a plain
# function over a geometry pair or a geometry array. DataFusion resolves a
# function name against one registry entry, so the released scalar function
# keeps the `ST_MakeLine` name and the aggregate is registered as
# `ST_MakeLineAgg`.

query T
SELECT ST_AsText(ST_MakeLineAgg(g ORDER BY id))
FROM (VALUES
    (2, ST_GeomFromText('POINT(2 2)')),
    (1, ST_GeomFromText('POINT(1 1)')),
    (3, ST_GeomFromText('POINT(3 3)'))
) AS t(id, g);
----
LINESTRING(1 1,2 2,3 3)

query IT
SELECT bucket, ST_AsText(ST_MakeLineAgg(g ORDER BY id))
FROM (VALUES
    (1, 0, ST_GeomFromText('POINT(1 1)')),
    (2, 0, ST_GeomFromText('POINT(2 2)')),
    (3, 1, ST_GeomFromText('POINT(3 3)')),
    (4, 1, ST_GeomFromText('POINT(4 4)'))
) AS t(id, bucket, g)
GROUP BY bucket
ORDER BY bucket;
----
0 LINESTRING(1 1,2 2)
1 LINESTRING(3 3,4 4)

query IT
SELECT id, ST_AsText(ST_MakeLineAgg(g) OVER (PARTITION BY bucket ORDER BY id))
FROM (VALUES
    (1, 0, ST_GeomFromText('POINT(1 1)')),
    (2, 0, ST_GeomFromText('POINT(2 2)')),
    (3, 1, ST_GeomFromText('POINT(3 3)')),
    (4, 1, ST_GeomFromText('POINT(4 4)'))
) AS t(id, bucket, g)
ORDER BY id;
----
1 LINESTRING(1 1)
2 LINESTRING(1 1,2 2)
3 LINESTRING(3 3)
4 LINESTRING(3 3,4 4)

query T
SELECT ST_AsText(ST_MakeLineAgg(g))
FROM (VALUES (ST_GeomFromText('MULTIPOINT(0 0,1 1)'))) AS t(g);
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_MakeLineAgg(g ORDER BY id))
FROM (VALUES
    (1, ST_GeomFromText('POINT EMPTY')),
    (2, ST_GeomFromText('POINT(1 1)'))
) AS t(id, g);
----
LINESTRING(1 1)

query B
SELECT ST_MakeLineAgg(g) IS NULL
FROM (SELECT ST_GeomFromText('POINT(1 1)') AS g WHERE false) AS t;
----
true

query T
SELECT ST_AsText(ST_MakeLineAgg(g ORDER BY id))
FROM (VALUES
    (1, ST_GeomFromText('POINT ZM(1 1 3 6)')),
    (2, ST_GeomFromText('POINT ZM(2 2 4 5)'))
) AS t(id, g);
----
LINESTRING ZM(1 1 3 6,2 2 4 5)

query T
SELECT ST_AsText(ST_MakeLineAgg(DISTINCT g ORDER BY id))
FROM (VALUES
    (1, ST_GeomFromText('POINT(0 0)')),
    (2, ST_GeomFromText('POINT(0 0)')),
    (3, ST_GeomFromText('POINT(1 1)'))
) AS t(id, g);
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_MakeLineAgg(g ORDER BY id) FILTER (WHERE id = 2))
FROM (VALUES
    (1, ST_GeomFromText('POINT(0 0)')),
    (2, ST_GeomFromText('POINT(1 1)'))
) AS t(id, g);
----
LINESTRING(1 1)

query IT
SELECT id, ST_AsText(ST_MakeLine(a, b))
FROM (VALUES
    (1, ST_GeomFromText('POINT(0 0)'), ST_GeomFromText('POINT(1 1)')),
    (2, ST_GeomFromText('POINT(2 2)'), ST_GeomFromText('POINT(3 3)'))
) AS t(id, a, b)
ORDER BY id;
----
1 LINESTRING(0 0,1 1)
2 LINESTRING(2 2,3 3)

query T
SELECT ST_AsText(ST_MakeLine(a, b)) AS line
FROM (VALUES
    (0, ST_GeomFromText('POINT(0 0)'), ST_GeomFromText('POINT(1 1)')),
    (1, ST_GeomFromText('POINT(2 2)'), ST_GeomFromText('POINT(3 3)'))
) AS t(id, a, b)
GROUP BY a, b
ORDER BY line;
----
LINESTRING(0 0,1 1)
LINESTRING(2 2,3 3)

statement error expects one geometry argument per row
SELECT ST_MakeLineAgg(a, b)
FROM (VALUES (ST_GeomFromText('POINT(0 0)'), ST_GeomFromText('POINT(1 1)'))) AS t(a, b);
