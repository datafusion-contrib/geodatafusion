# GEOS-backed ST_Normalize and ST_Snap contracts. Run only with geos-3_11 enabled.
#
# Expected values were reviewed against PostGIS 3.6.4 and the typed, raw-Arrow
# differential baselines under tests/postgis/geos.

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromText('POINT ZM(1 2 3 4)')));
----
POINT Z(1 2 3)

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromText('POINT M(1 2 3)')));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromText('LINESTRING Z(2 2 4,1 1 3)')));
----
LINESTRING Z(1 1 3,2 2 4)

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))')));
----
POLYGON((0 0,0 10,10 10,10 0,0 0))

query T
SELECT ST_AsText(ST_Normalize(
    ST_GeomFromText('GEOMETRYCOLLECTION(POINT(2 3),MULTILINESTRING((0 0,1 1),(2 2,3 3)),POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,4 2,4 4,2 4,2 2),(6 6,8 6,8 8,6 8,6 6)))')
));
----
GEOMETRYCOLLECTION(POLYGON((0 0,0 10,10 10,10 0,0 0),(6 6,8 6,8 8,6 8,6 6),(2 2,4 2,4 4,2 4,2 2)),MULTILINESTRING((2 2,3 3),(0 0,1 1)),POINT(2 3))

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromEWKT('SRID=3857;POINT(1 2)')));
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_Normalize(ST_GeomFromEWKT('SRID=3857;POINT(1 2)')));
----
SRID=3857;POINT(1 2)

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromText('LINESTRING EMPTY')));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_Normalize(ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10))));
----
POLYGON((0 0,0 10,10 10,10 0,0 0))

query T
SELECT ST_AsText(ST_Normalize(ST_GeomFromText(NULL)));
----
NULL

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0))'),
    ST_GeomFromText('LINESTRING(0 0,5 0,10 10)'),
    1
));
----
POLYGON((0 0,5 0,10 0,10 10,0 10,0 0))

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('POINT(30 30)'),
    ST_GeomFromText('LINESTRING(0 0,10 0)'),
    1
));
----
POINT(30 30)

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('POINT ZM(3 3 30 300)'),
    ST_GeomFromText('POINT(5 5)'),
    10
));
----
POINT(5 5)

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING M(0 0 5,10 0 5)'),
    ST_GeomFromText('POINT M(0 0 7)'),
    1
));
----
LINESTRING(0 0,10 0)

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING Z(0 0 1,10 0 2)'),
    ST_GeomFromText('POINT Z(0 0 5)'),
    1
));
----
LINESTRING Z(0 0 5,10 0 2)

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING EMPTY'),
    ST_GeomFromText('POINT(1 1)'),
    1
));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING Z EMPTY'),
    ST_GeomFromText('POINT Z(1 1 2)'),
    1
));
----
LINESTRING Z EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING M EMPTY'),
    ST_GeomFromText('POINT M(1 1 2)'),
    1
));
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING ZM EMPTY'),
    ST_GeomFromText('POINT ZM(1 1 2 3)'),
    1
));
----
LINESTRING Z EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING EMPTY'),
    ST_GeomFromText('POINT Z(1 1 2)'),
    1
));
----
LINESTRING Z EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING Z EMPTY'),
    ST_GeomFromText('POINT(1 1)'),
    1
));
----
LINESTRING Z EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('POINT ZM EMPTY'),
    ST_GeomFromText('POINT(1 1)'),
    1
));
----
POINT Z EMPTY

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText(NULL),
    ST_GeomFromText('POINT(1 1)'),
    1
));
----
NULL

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING EMPTY'),
    ST_GeomFromText(NULL),
    1
));
----
NULL

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING(0 0,10 0)'),
    ST_GeomFromText('POINT(0 0)'),
    0
));
----
LINESTRING(0 0,10 0)

query T
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING(0 0,10 0)'),
    ST_GeomFromText('POINT(0 0)'),
    NULL
));
----
NULL

query T
SELECT ST_AsText(ST_Snap(
    ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)),
    ST_GeomFromText('POINT(10 10)'),
    6
));
----
POLYGON((0 0,0 10,10 10,10 0,0 0))

statement error mixed SRID
SELECT ST_Snap(
    ST_GeomFromEWKT('SRID=4326;POINT(1 2)'),
    ST_GeomFromEWKT('SRID=3857;POINT(3 4)'),
    1
);
