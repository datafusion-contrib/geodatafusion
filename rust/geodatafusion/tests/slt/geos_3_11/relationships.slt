# GEOS 3.11-backed relationship contracts.
#
# Requires the `geos-3_11` feature. Expected values were reviewed against
# PostGIS 3.6.4 and the typed baseline under tests/postgis/relationships.
# Boundary node rules 3 and 4 require GEOS >= 3.13: the legacy relate
# engine in older releases returns non-conforming matrices for those rules,
# so the UDF rejects them with an unsupported-version error instead.

query B
SELECT ST_ContainsProperly(
    ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'),
    ST_GeomFromText('POINT(2 2)')
);
----
true

query B
SELECT ST_ContainsProperly(
    ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'),
    ST_GeomFromText('POINT(0 2)')
);
----
false

query B
SELECT ST_ContainsProperly(
    ST_GeomFromText('POLYGON EMPTY'),
    ST_GeomFromText('POINT EMPTY')
);
----
false

query B
SELECT ST_ContainsProperly(
    ST_GeomFromText(NULL),
    ST_GeomFromText('POINT(0 0)')
);
----
NULL

query T
SELECT ST_Relate(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 1)')
);
----
FF0FFF0F2

query B
SELECT ST_Relate(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 1)'),
    'FF*FF****'
);
----
true

query B
SELECT ST_Relate(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 1)'),
    'ff*ff****ignored'
);
----
true

query T
SELECT ST_Relate(
    ST_GeomFromText('MULTILINESTRING((0 0,1 1),(1 1,2 2))'),
    ST_GeomFromText('POINT(1 1)'),
    2
);
----
FF10F0FF2

onlyif geos_relateng
query T
SELECT ST_Relate(
    ST_GeomFromText('MULTILINESTRING((0 0,1 1),(1 1,2 2))'),
    ST_GeomFromText('POINT(1 1)'),
    3
);
----
FF10FFFF2

onlyif geos_relateng
query T
SELECT ST_Relate(
    ST_GeomFromText('MULTILINESTRING((0 0,1 1),(1 1,2 2),(1 1,2 0))'),
    ST_GeomFromText('POINT(1 1)'),
    4
);
----
0F1FF0FF2

skipif geos_relateng
statement error requires GEOS >= 3.13
SELECT ST_Relate(
    ST_GeomFromText('MULTILINESTRING((0 0,1 1),(1 1,2 2))'),
    ST_GeomFromText('POINT(1 1)'),
    3
);

skipif geos_relateng
statement error requires GEOS >= 3.13
SELECT ST_Relate(
    ST_GeomFromText('MULTILINESTRING((0 0,1 1),(1 1,2 2),(1 1,2 0))'),
    ST_GeomFromText('POINT(1 1)'),
    4
);

query T
SELECT ST_Relate(
    ST_GeomFromText(NULL),
    ST_GeomFromText('POINT(1 1)'),
    0
);
----
NULL

statement error length 9
SELECT ST_Relate(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 1)'),
    'FF*FF***'
);

statement error Invalid boundary node rule 5
SELECT ST_Relate(
    ST_GeomFromText('POINT(0 0)'),
    ST_GeomFromText('POINT(1 1)'),
    5
);

statement error mixed SRID
SELECT ST_ContainsProperly(
    ST_PointFromText('POINT(1 2)', 4326),
    ST_PointFromText('POINT(1 2)', 3857)
);
