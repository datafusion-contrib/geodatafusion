# GEOS-backed ST_IsRing and ST_IsSimple contracts.

query B
SELECT ST_IsRing(ST_GeomFromText('LINESTRING(0 0,1 0,1 1,0 0)'));
----
true

query B
SELECT ST_IsRing(ST_GeomFromText('LINESTRING(0 0,1 0,1 1)'));
----
false

query B
SELECT ST_IsRing(ST_GeomFromText('LINESTRING(0 0,2 2,2 0,0 2,0 0)'));
----
false

query B
SELECT ST_IsRing(ST_GeomFromText('LINESTRING EMPTY'));
----
false

query B
SELECT ST_IsRing(ST_GeomFromText(NULL));
----
NULL

query B
SELECT ST_IsSimple(ST_GeomFromText('POINT(0 0)'));
----
true

query B
SELECT ST_IsSimple(ST_GeomFromText('LINESTRING(0 0,2 2,2 0,0 2)'));
----
false

query B
SELECT ST_IsSimple(ST_GeomFromText('LINESTRING(0 0,1 1,2 0,1 0,0 0)'));
----
true

query B
SELECT ST_IsSimple(ST_GeomFromText('MULTIPOINT(0 0,1 1,0 0)'));
----
false

query B
SELECT ST_IsSimple(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY'));
----
true

query B
SELECT ST_IsSimple(ST_GeomFromText(NULL));
----
NULL

statement error linear feature
SELECT ST_IsRing(ST_GeomFromText('POINT(0 0)'));
