# ST_ConcaveHull contracts. Run only with geos-3_11 enabled. Expected values
# were reviewed against the typed baseline under tests/postgis/geos/concave_hull.

query T
SELECT ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('MULTIPOINT((0 0),(0 4),(2 4),(2 1),(4 1),(4 0))'),
    0.3
));
----
POLYGON((2 1,0 4,2 4,4 1,4 0,0 0,2 1))

query T
SELECT ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('MULTIPOINT((0 0),(0 4),(2 4),(2 1),(4 1),(4 0))'),
    1.0
));
----
POLYGON((0 0,0 4,2 4,4 1,4 0,0 0))

# A polygonal input keeps the holes it already has: allow_holes only controls
# holes the hull itself would create between separate input polygons.
query T
SELECT ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('POLYGON((0 0,10 0,10 10,0 10,0 0),(3 3,7 3,7 7,3 7,3 3))'),
    0.9
));
----
POLYGON((0 0,10 0,10 10,0 10,0 0),(3 3,7 3,7 7,3 7,3 3))

query I
SELECT ST_NumInteriorRings(ST_ConcaveHull(
    ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 1,0 0)),((3 0,4 0,4 1,3 1,3 0)),((3 3,4 3,4 4,3 4,3 3)),((0 3,1 3,1 4,0 4,0 3)))'),
    0.9,
    false
));
----
0

query I
SELECT ST_NumInteriorRings(ST_ConcaveHull(
    ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 1,0 0)),((3 0,4 0,4 1,3 1,3 0)),((3 3,4 3,4 4,3 4,3 3)),((0 3,1 3,1 4,0 4,0 3)))'),
    0.9,
    true
));
----
1

# Degenerate inputs keep their own dimension: one point stays a point and
# two points produce the line between them.
query T
SELECT ST_AsText(ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), 0.5));
----
POINT(1 2)

query T
SELECT ST_AsText(ST_ConcaveHull(ST_GeomFromText('MULTIPOINT((0 0),(1 1))'), 0.5));
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0),POINT(1 0),POINT(0 1))'),
    0.5
));
----
POLYGON((0 1,1 0,0 0,0 1))

query T
SELECT ST_AsText(ST_ConcaveHull(ST_GeomFromText('POINT EMPTY'), 0.5));
----
POLYGON EMPTY

# Z is preserved, M is dropped: PostGIS returns the same dimensions.
query I
SELECT ST_NDims(ST_ConcaveHull(
    ST_GeomFromText('POLYGON Z ((0 0 1,10 0 2,10 10 3,0 10 4,0 0 1),(3 3 5,7 3 6,7 7 7,3 7 8,3 3 5))'),
    0.9
));
----
3

query I
SELECT ST_NDims(ST_ConcaveHull(
    ST_GeomFromText('POLYGON M ((0 0 1,10 0 2,10 10 3,0 10 4,0 0 1),(3 3 5,7 3 6,7 7 7,3 7 8,3 3 5))'),
    0.9
));
----
2

query T
SELECT ST_AsText(ST_ConcaveHull(ST_GeomFromText(NULL), 0.5));
----
NULL

query T
SELECT ST_AsText(ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), CAST(NULL AS DOUBLE)));
----
NULL

query T
SELECT ST_AsText(ST_ConcaveHull(
    ST_GeomFromText('POINT(1 2)'),
    0.5,
    CAST(NULL AS BOOLEAN)
));
----
NULL

statement error must be in \[0, 1\]
SELECT ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), 1.5);

statement error must be in \[0, 1\]
SELECT ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), -0.25);

statement error must be boolean, got Utf8
SELECT ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'), 0.5, 'yes');

statement error expects 2 or 3 arguments
SELECT ST_ConcaveHull(ST_GeomFromText('POINT(1 2)'));
