# GEOS-backed geometry processing contracts. Run only with geos-3_11 enabled.

query T
SELECT ST_AsText(ST_BuildArea(
    ST_GeomFromText('LINESTRING(0 0,10 0,10 10,0 10,0 0)')
));
----
POLYGON((0 0,0 10,10 10,10 0,0 0))

query T
SELECT ST_AsText(ST_BuildArea(ST_GeomFromText('LINESTRING(0 0,1 1)')));
----
NULL

query T
SELECT ST_AsText(ST_TriangulatePolygon(
    ST_GeomFromText('POLYGON((0 0,4 0,4 4,2 2,0 4,0 0))')
));
----
GEOMETRYCOLLECTION(POLYGON((0 0,0 4,2 2,0 0)),POLYGON((2 2,4 4,4 0,2 2)),POLYGON((4 0,0 0,2 2,4 0)))

query T
SELECT ST_AsText(ST_DelaunayTriangles(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)')
));
----
GEOMETRYCOLLECTION(POLYGON((0 1,0 0,1 0,0 1)))

query T
SELECT ST_AsText(ST_DelaunayTriangles(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)'),
    0,
    1
));
----
MULTILINESTRING((0 1,1 0),(0 0,0 1),(0 0,1 0))

statement error TIN output
SELECT ST_DelaunayTriangles(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)'),
    0,
    2
);

statement error must be 0, 1, or 2
SELECT ST_DelaunayTriangles(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)'),
    0,
    3
);

query T
SELECT ST_AsText(ST_OffsetCurve(
    ST_GeomFromText('LINESTRING(0 0,10 0,10 10)'),
    1
));
----
LINESTRING(0 1,9 1,9 10)

query T
SELECT ST_AsText(ST_OffsetCurve(
    ST_GeomFromText('LINESTRING(0 0,10 0,10 10)'),
    0
));
----
LINESTRING(0 0,10 0,10 10)

statement error does not support buffer parameter 'side'
SELECT ST_OffsetCurve(
    ST_GeomFromText('LINESTRING(0 0,10 0,10 10)'),
    1,
    'side=left'
);

query T
SELECT ST_AsText(ST_ReducePrecision(
    ST_GeomFromText('POINT(1.25 2.75)'),
    0.5
));
----
POINT(1.5 3)

# Decimal grids round through the native GEOS path, which can differ by one
# ULP between GEOS 3.11 and 3.14 or newer, so compare the grid value instead
# of the exact text.
query B
SELECT abs(ST_X(ST_ReducePrecision(
    ST_GeomFromText('POINT(1.2345 2.3456)'),
    0.1
)) - 1.2) < 0.000000000000001
AND abs(ST_Y(ST_ReducePrecision(
    ST_GeomFromText('POINT(1.2345 2.3456)'),
    0.1
)) - 2.3) < 0.000000000000001;
----
true

query T
SELECT ST_AsText(ST_ReducePrecision(
    ST_GeomFromText('POLYGON((0.1 0.1,0.14 0.1,0.14 0.14,0.1 0.14,0.1 0.1))'),
    1
));
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_SharedPaths(
    ST_GeomFromText('LINESTRING(0 0,10 0)'),
    ST_GeomFromText('LINESTRING(0 0,10 0)')
));
----
GEOMETRYCOLLECTION(MULTILINESTRING((0 0,10 0)),MULTILINESTRING EMPTY)

query T
SELECT ST_AsText(ST_SharedPaths(
    ST_GeomFromText('LINESTRING(0 0,10 0)'),
    ST_GeomFromText('LINESTRING(10 0,0 0)')
));
----
GEOMETRYCOLLECTION(MULTILINESTRING EMPTY,MULTILINESTRING((0 0,10 0)))

query T
SELECT ST_AsText(ST_VoronoiLines(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)')
));
----
MULTILINESTRING((0.5 -1,0.5 0.5),(0.5 0.5,2 2),(-1 0.5,0.5 0.5))

query T
SELECT ST_AsText(ST_VoronoiPolygons(ST_GeomFromText('POINT(0 0)')));
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_AsText(ST_VoronoiLines(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)'),
    0,
    NULL
));
----
MULTILINESTRING((0.5 -1,0.5 0.5),(0.5 0.5,2 2),(-1 0.5,0.5 0.5))

statement error tolerance must be non-negative
SELECT ST_VoronoiLines(
    ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)'),
    -1
);

query T
SELECT ST_AsText(ST_Intersection(
    ST_GeomFromText('LINESTRING ZM (0 0 0 0,4 0 4 4)'),
    ST_GeomFromText('LINESTRING ZM (2 -1 10 100,2 1 20 200)')
));
----
POINT Z(2 0 8.5)

query T
SELECT ST_AsText(ST_Difference(
    ST_GeomFromText('LINESTRING ZM (0 0 0 0,4 0 4 4)'),
    ST_GeomFromText('POINT EMPTY')
));
----
LINESTRING ZM(0 0 0 0,4 0 4 4)
