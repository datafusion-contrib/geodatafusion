# ST_AsMVTGeom SQL contract. This function requires GEOS.

query T
SELECT ST_AsText(ST_AsMVTGeom(ST_GeomFromText('POINT(1 2)'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4))));
----
POINT(1024 2048)

query T
SELECT ST_AsText(ST_AsMVTGeom(ST_GeomFromText('POINT(-0.1 2)'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4))));
----
POINT(-102 2048)

query B
SELECT ST_AsMVTGeom(ST_GeomFromText('POINT(-1 2)'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4))) IS NULL;
----
true

query T
SELECT ST_AsText(ST_AsMVTGeom(ST_GeomFromText('LINESTRING(1 2,5 6)'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4))));
----
LINESTRING(1024 2048,3328 -256)

query T
SELECT ST_AsText(ST_AsMVTGeom(ST_GeomFromText('POINT(-1 2)'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)), 4096, 256, false));
----
POINT(-1024 2048)

query B
SELECT ST_Area(ST_AsMVTGeom(ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)))) = 16777216
   AND ST_XMin(ST_AsMVTGeom(ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)))) = 0
   AND ST_YMin(ST_AsMVTGeom(ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)))) = 0
   AND ST_XMax(ST_AsMVTGeom(ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)))) = 4096
   AND ST_YMax(ST_AsMVTGeom(ST_GeomFromText('POLYGON((0 0,0 4,4 4,4 0,0 0))'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)))) = 4096;
----
true

query T
SELECT ST_AsText(ST_AsMVTGeom(ST_GeomFromText('POINT ZM(1 2 3 4)'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4))));
----
POINT ZM(1024 2048 3 4)

query B
SELECT ST_AsMVTGeom(ST_GeomFromText('POINT EMPTY'), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4))) IS NULL;
----
true

query T
SELECT ST_AsText(ST_AsMVTGeom(
    ST_GeomFromText('POINT(1 2)'),
    ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)),
    CAST(NULL AS BIGINT),
    CAST(NULL AS BIGINT),
    CAST(NULL AS BOOLEAN)
));
----
POINT(1024 2048)

statement error Extent must be greater than 0
SELECT ST_AsMVTGeom(ST_Point(1, 2), ST_MakeBox2D(ST_Point(0, 0), ST_Point(4, 4)), 0, 256, true);

statement error Geometric bounds are too small
SELECT ST_AsMVTGeom(ST_Point(1, 2), ST_MakeBox2D(ST_Point(1, 0), ST_Point(1, 4)));
