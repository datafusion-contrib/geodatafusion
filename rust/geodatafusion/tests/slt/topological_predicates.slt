# Topological predicate and 2D validity contracts.
#
# Expected values were reviewed against PostGIS 3.6.4 through the typed
# baselines under tests/postgis/relationships. Predicates evaluate in 2D: Z and
# M ordinates do not change the answer, matching PostGIS.

query B
SELECT ST_IsValid(ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'));
----
true

query B
SELECT ST_IsValid(ST_GeomFromText('POLYGON((0 0,2 2,2 0,0 2,0 0))'));
----
false

query B
SELECT ST_IsValid(ST_GeomFromText('POINT EMPTY'));
----
true

query B
SELECT ST_IsValid(ST_GeomFromText('MULTIPOINT(EMPTY,1 1)'));
----
true

query B
SELECT ST_IsValid(ST_GeomFromText('GEOMETRYCOLLECTION(POINT EMPTY)'));
----
true

query B
SELECT ST_IsValid(ST_GeomFromText('POLYGON Z ((0 0 1,2 0 2,2 2 3,0 2 4,0 0 1))'));
----
true

query B
SELECT ST_IsValid(ST_GeomFromText(NULL));
----
NULL

query T
SELECT ST_IsValidReason(ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'));
----
Valid Geometry

query T
SELECT ST_IsValidReason(ST_GeomFromText('POINT EMPTY'));
----
Valid Geometry

# PostGIS reports `Self-intersection[1 1]` here; the native checker reports the
# geo crate wording. The difference is documented in README.md.
query T
SELECT ST_IsValidReason(ST_GeomFromText('POLYGON((0 0,2 2,2 0,0 2,0 0))'));
----
exterior ring has a self-intersection

query T
SELECT ST_IsValidReason(ST_GeomFromText(NULL));
----
NULL

query B
SELECT ST_Intersects(
    ST_GeomFromText('POINT(1 1)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
true

query B
SELECT ST_Intersects(
    ST_GeomFromText('POINT(5 5)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
false

query B
SELECT ST_Intersects(
    ST_GeomFromText('POINT(2 2)'),
    ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,3 1,3 3,1 3,1 1))')
);
----
false

query B
SELECT ST_Intersects(
    ST_GeomFromText('POINT EMPTY'),
    ST_GeomFromText('POLYGON EMPTY')
);
----
false

query B
SELECT ST_Intersects(
    ST_GeomFromText('POINT M (1 1 7)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
true

query B
SELECT ST_Intersects(
    ST_GeomFromText(NULL),
    ST_GeomFromText('POINT(1 1)')
);
----
NULL

query B
SELECT ST_Contains(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POINT(1 1)')
);
----
true

query B
SELECT ST_Contains(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POINT(0 1)')
);
----
false

query B
SELECT ST_Contains(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POINT EMPTY')
);
----
false

query B
SELECT ST_Contains(
    ST_GeomFromText('GEOMETRYCOLLECTION(POLYGON((0 0,2 0,2 2,0 2,0 0)),POINT(1 1))'),
    ST_GeomFromText('POINT(1 1)')
);
----
true

query B
SELECT ST_Covers(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POINT(0 1)')
);
----
true

query B
SELECT ST_Covers(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POLYGON((2 0,4 0,4 2,2 2,2 0))')
);
----
false

query B
SELECT ST_CoveredBy(
    ST_GeomFromText('POINT(0 1)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
true

query B
SELECT ST_CoveredBy(
    ST_GeomFromText('POLYGON((2 0,4 0,4 2,2 2,2 0))'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
false

query B
SELECT ST_Touches(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POLYGON((2 0,4 0,4 2,2 2,2 0))')
);
----
true

query B
SELECT ST_Touches(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POLYGON((1 1,3 1,3 3,1 3,1 1))')
);
----
false

query B
SELECT ST_Crosses(
    ST_GeomFromText('LINESTRING(-1 1,3 1)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
true

query B
SELECT ST_Crosses(
    ST_GeomFromText('LINESTRING(0 0,2 0)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
false

query B
SELECT ST_Overlaps(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POLYGON((1 1,3 1,3 3,1 3,1 1))')
);
----
true

query B
SELECT ST_Overlaps(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POLYGON((0.5 0.5,1.5 0.5,1.5 1.5,0.5 1.5,0.5 0.5))')
);
----
false

query B
SELECT ST_Disjoint(
    ST_GeomFromText('POINT(5 5)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
true

query B
SELECT ST_Disjoint(
    ST_GeomFromText('POINT(1 1)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
false

query B
SELECT ST_Equals(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('POLYGON((2 0,2 2,0 2,0 0,2 0))')
);
----
true

query B
SELECT ST_Equals(
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),
    ST_GeomFromText('LINESTRING(0 0,2 0,2 2,0 2,0 0)')
);
----
false

query B
SELECT ST_Equals(
    ST_GeomFromText('POINT Z (1 1 5)'),
    ST_GeomFromText('POINT(1 1)')
);
----
true

query B
SELECT ST_Within(
    ST_GeomFromText('POINT(1 1)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
true

query B
SELECT ST_Within(
    ST_GeomFromText('POINT(0 1)'),
    ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))')
);
----
false

# PostGIS rejects predicates across mixed SRIDs, including an unknown SRID
# paired with a declared one.
statement error mixed SRID geometries
SELECT ST_Intersects(
    ST_PointFromText('POINT(1 2)', 0),
    ST_PointFromText('POINT(1 2)', 4326)
);

statement error mixed SRID geometries
SELECT ST_Contains(
    ST_PointFromText('POINT(1 2)', 4326),
    ST_PointFromText('POINT(1 2)', 3857)
);

# The 2D validity checks are unary, so a declared SRID is not a conflict.
query B
SELECT ST_IsValid(ST_PointFromText('POINT(1 2)', 4326));
----
true
