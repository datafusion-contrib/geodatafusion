# TWKB and Geobuf SQL contracts.

query T
SELECT encode(ST_AsTWKB(ST_GeomFromText('POINT(1.23456789 2.3456789)')), 'hex')
----
01000204

query T
SELECT encode(ST_AsTWKB(ST_GeomFromText('POINT(1.23456789 2.3456789)'), 3), 'hex')
----
6100a613d424

query T
SELECT encode(ST_AsTWKB(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')), 'hex')
----
0710

query I
SELECT ST_Zmflag(ST_GeomFromTWKB(ST_AsTWKB(ST_GeomFromText('POINT ZM (1 2 3 4)'), 6, 6, 6)))
----
3

query T
SELECT encode(ST_AsTWKB(
    ARRAY[ST_GeomFromText('POINT(1 2)'), ST_GeomFromText('POINT(3 4)')],
    ARRAY[10, 20]
), 'hex')
----
040402142802040404

query T
SELECT encode(ST_AsTWKB(
    ARRAY[ST_GeomFromText('POINT(1 2)'), ST_GeomFromText('LINESTRING(0 0,1 1)')],
    ARRAY[7, 8]
), 'hex')
----
0704020e100100020402000200000202

query T
SELECT ST_AsEWKT(ST_GeomFromTWKB(ST_AsTWKB(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY'))))
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_AsEWKT(ST_GeomFromTWKB(decode('07000101000204', 'hex')))
----
GEOMETRYCOLLECTION(POINT(1 2))

statement error exceeds remaining
SELECT ST_GeomFromTWKB(decode('0400ffffffffffffffffff01', 'hex'))

statement error varint overflow
SELECT ST_GeomFromTWKB(decode('0200ffffffffffffffffff02', 'hex'))

query B
SELECT ST_AsTWKB(NULL) IS NULL
----
true

query B
SELECT ST_GeomFromTWKB(NULL) IS NULL
----
true

# An unclassifiable CRS cannot select the default precision.
statement error pass an explicit X/Y precision
SELECT ST_AsTWKB(ST_GeomFromEWKT('SRID=999999;POINT(1 2)'));

query T
SELECT encode(ST_AsTWKB(ST_GeomFromEWKT('SRID=999999;POINT(1 2)'), 0), 'hex')
----
01000204

query T rowsort
SELECT encode(ST_AsTWKB(ST_GeomFromText(wkt)), 'hex')
FROM (
    SELECT 'POINT(1 2)' AS wkt
    UNION ALL
    SELECT 'POINT(3 4)' AS wkt
) AS t
----
01000204
01000608

query T rowsort
SELECT encode(ST_AsTWKB(ST_GeomFromText(wkt), prec), 'hex')
FROM (
    SELECT 'POINT(1.23456789 2.3456789)' AS wkt, CAST(NULL AS BIGINT) AS prec
    UNION ALL
    SELECT 'POINT(1.23456789 2.3456789)', 3
) AS t
----
01000204
6100a613d424

query T rowsort
SELECT encode(ST_AsTWKB(ST_GeomFromText(wkt), prec), 'hex')
FROM (
    SELECT 'POINT(1.23456789 2.3456789)' AS wkt, CAST(NULL AS INT) AS prec
    UNION ALL
    SELECT 'POINT(1.23456789 2.3456789)', CAST(3 AS INT)
) AS t
----
01000204
6100a613d424

query T
SELECT encode(ST_AsTWKB(ST_GeomFromText('POINT(3 4)'), CAST(3 AS INT)), 'hex')
----
6100f02ec03e

statement error Z precision
SELECT ST_AsTWKB(ST_GeomFromText('POINT Z (1 2 3)'), 0, -1)

statement error must match
SELECT ST_AsTWKB(ARRAY[ST_GeomFromText('POINT(1 2)')], ARRAY[1, 2])

query T
SELECT encode(ST_AsGeobuf(named_struct(
    'geom', ST_GeomFromText('POINT(1.5 2.5)'),
    'name', 'alpha',
    'n', 7,
    'nullable', CAST(NULL AS VARCHAR)
)), 'hex')
----
0a046e616d650a016e0a086e756c6c61626c651801221d0a1b0a0608001a021e326a070a05616c7068616a021807720400000101

query T
SELECT encode(ST_AsGeobuf(named_struct(
    'geom', ST_GeomFromText('POINT(1 2)'),
    'name', 'alpha'
), 'geom'), 'hex')
----
0a046e616d65180022170a150a0608001a0202046a070a05616c70686172020000

query T
SELECT encode(ST_AsGeobuf(named_struct(
    'geom', ST_GeomFromText(NULL),
    'name', 'alpha'
)), 'hex')
----
0a046e616d6518002200

query T
SELECT encode(ST_AsGeobuf(named_struct(
    'geom', ST_GeomFromText('POINT(1 2)'),
    'name', 'alpha'
)), 'hex')
FROM (SELECT 1 WHERE FALSE)
----
NULL

statement error no geometry column
SELECT ST_AsGeobuf(named_struct('name', 'alpha'))

statement error first argument must be a struct row
SELECT ST_AsGeobuf(1)

statement error does not support property type
SELECT ST_AsGeobuf(named_struct(
    'geom', ST_GeomFromText('POINT(1 2)'),
    'ts', CAST('2020-01-01 00:00:00' AS TIMESTAMP)
))
