# ST_Extent aggregate basics.
#
# Multi-partition Partial -> Final execution and state-field names are
# covered by extent_registration.rs.

query RRRR
SELECT
    ST_XMin(ST_Extent(ST_GeomFromText('POLYGON((743238 2967416,743238 2967450,743265 2967450,743265.625 2967416,743238 2967416))'))),
    ST_YMin(ST_Extent(ST_GeomFromText('POLYGON((743238 2967416,743238 2967450,743265 2967450,743265.625 2967416,743238 2967416))'))),
    ST_XMax(ST_Extent(ST_GeomFromText('POLYGON((743238 2967416,743238 2967450,743265 2967450,743265.625 2967416,743238 2967416))'))),
    ST_YMax(ST_Extent(ST_GeomFromText('POLYGON((743238 2967416,743238 2967450,743265 2967450,743265.625 2967416,743238 2967416))')));
----
743238 2967416 743265.625 2967450

query IRRRR
SELECT
    g,
    ST_XMin(ST_Extent(geom)),
    ST_YMin(ST_Extent(geom)),
    ST_XMax(ST_Extent(geom)),
    ST_YMax(ST_Extent(geom))
FROM (
    SELECT 1 AS g, ST_GeomFromText('POINT(1 2)') AS geom
    UNION ALL
    SELECT 1 AS g, ST_GeomFromText('POINT(3 5)') AS geom
    UNION ALL
    SELECT 2 AS g, ST_GeomFromText('LINESTRING(-1 10, 4 12)') AS geom
) AS t
GROUP BY g
ORDER BY g;
----
1 1 2 3 5
2 -1 10 4 12
