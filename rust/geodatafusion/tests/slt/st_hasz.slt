query BB
SELECT
  ST_HasZ(ST_GeomFromText('GEOMETRYCOLLECTION Z(POINT Z(1 2 3))')),
  ST_HasZ(ST_GeomFromText('GEOMETRYCOLLECTION M(POINT M(1 2 4))'));
----
true false

