query BBBB
SELECT
  ST_HasZ(ST_GeomFromText('POINT(1 2)')),
  ST_HasZ(ST_GeomFromText('POINT Z(1 2 3)')),
  ST_HasZ(ST_GeomFromText('POINT M(1 2 4)')),
  ST_HasZ(ST_GeomFromText('POINT ZM(1 2 3 4)'));
----
false true false true

query BBBB
