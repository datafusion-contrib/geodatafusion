# EWKT and EWKB input/output contracts.
#
# Expected values were reviewed against PostGIS 3.6.4 and the raw-Arrow
# differential baseline under tests/postgis/io.

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1 2)'));
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1 2 3)'));
----
POINT(1 2 3)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINTM(1 2 3)'));
----
POINTM(1 2 3)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1 2 3 4)'));
----
POINT(1 2 3 4)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=4326;POINT Z (1 2 3)'));
----
SRID=4326;POINT(1 2 3)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=-1;POINT(1 2)'));
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=1000000;POINT(1 2)'));
----
SRID=999001;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=2147483647;POINT(1 2)'));
----
SRID=999280;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=4326;POINT EMPTY'));
----
SRID=4326;POINT EMPTY

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=4326;MULTIPOINT((1 2),(3 4))'));
----
SRID=4326;MULTIPOINT(1 2,3 4)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=4326;GEOMETRYCOLLECTION(POINT(1 2))'));
----
SRID=4326;GEOMETRYCOLLECTION(POINT(1 2))

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1.23e-9 9.6e+16)'));
----
POINT(1.23e-9 9.6e+16)

query T
SELECT ST_AsEWKT(
    ST_GeomFromEWKT('POINT(1.123456789 2.987654321 3.555555555)'),
    2
);
----
POINT(1.12 2.99 3.56)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1.5 2.5)'), 0);
----
POINT(2 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1.5 2.5)'), -3);
----
POINT(2 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT(NULL));
----
NULL

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('POINT(1 2)'), CAST(NULL AS INT));
----
NULL

query T
SELECT ST_AsHEXEWKB(ST_GeomFromEWKT('SRID=4326;POINT(1 2)'));
----
0101000020E6100000000000000000F03F0000000000000040

query T
SELECT ST_AsHEXEWKB(ST_GeomFromEWKT('SRID=4326;POINT(1 2)'), 'XDR');
----
0020000001000010E63FF00000000000004000000000000000

query T
SELECT ST_AsHEXEWKB(ST_GeomFromEWKT('SRID=4326;POINT(1 2)'), 'Xdr');
----
0101000020E6100000000000000000F03F0000000000000040

query T
SELECT upper(encode(ST_AsEWKB(ST_GeomFromEWKT('SRID=4326;POINT Z (1 2 3)')), 'hex'));
----
01010000A0E6100000000000000000F03F00000000000000400000000000000840

query T
SELECT encode(
    ST_AsEWKB(
        ST_GeomFromEWKT('SRID=4326;POINT(1 2)'),
        CAST(NULL AS VARCHAR)
    ),
    'hex'
);
----
NULL

query T
SELECT ST_AsEWKT(ST_GeomFromEWKB(
    X'0101000020E6100000000000000000F03F0000000000000040'
));
----
SRID=4326;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKB(
    X'0020000001000010E63FF00000000000004000000000000000'
));
----
SRID=4326;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKB(
    X'0107000020E6100000010000000101000000000000000000F03F0000000000000040'
));
----
SRID=4326;GEOMETRYCOLLECTION(POINT(1 2))

query T
SELECT ST_AsEWKT(ST_GeomFromEWKB(
    X'0101000020FFFFFFFF000000000000F03F0000000000000040'
));
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKB(
    X'010100002040420F00000000000000F03F0000000000000040'
));
----
SRID=999001;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT(value)) AS value
FROM (
    VALUES
        ('POINT(1 2)'),
        ('GEOMETRYCOLLECTION(POINT(1 2))'),
        (NULL)
) AS input(value)
ORDER BY value NULLS LAST;
----
GEOMETRYCOLLECTION(POINT(1 2))
POINT(1 2)
NULL

# A field-level CRS cannot represent per-row SRIDs, so plain text input with a
# non-zero SRID is rejected instead of silently dropping the SRID.
statement error does not match declared CRS SRID 0
SELECT ST_GeomFromEWKT(value)
FROM (VALUES ('SRID=4326;POINT(1 2)')) AS input(value);

statement error mixes coordinate dimensions
SELECT ST_GeomFromEWKT('LINESTRING(1 2,3 4 5)');

statement error invalid EWKT SRID
SELECT ST_GeomFromEWKT('SRID=abc;POINT(1 2)');
