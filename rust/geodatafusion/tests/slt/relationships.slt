# Pure-Rust relationship contracts.
#
# Expected values were reviewed against PostGIS 3.6.4 and the typed baseline
# under tests/postgis/relationships.

query B
SELECT ST_OrderingEquals(ST_GeomFromText('POINT(1 2)'), ST_GeomFromText('POINT(1 2)'));
----
true

query B
SELECT ST_OrderingEquals(
    ST_GeomFromText('LINESTRING(0 0,1 1)'),
    ST_GeomFromText('LINESTRING(1 1,0 0)')
);
----
false

query B
SELECT ST_OrderingEquals(
    ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'),
    ST_GeomFromText('POLYGON((1 0,1 1,0 1,0 0,1 0))')
);
----
false

query B
SELECT ST_OrderingEquals(
    ST_GeomFromText('POINT(-0.0 0)'),
    ST_GeomFromText('POINT(0.0 0)')
);
----
false

query B
SELECT ST_OrderingEquals(
    ST_GeomFromText('POINT EMPTY'),
    ST_GeomFromText('POINT EMPTY')
);
----
true

query B
SELECT ST_OrderingEquals(
    ST_PointFromText('POINT(1 2)', 4326),
    ST_PointFromText('POINT(1 2)', 3857)
);
----
false

query B
SELECT ST_OrderingEquals(
    ST_GeomFromText(NULL),
    ST_GeomFromText('POINT(1 2)')
);
----
NULL

query B
SELECT ST_RelateMatch('101010101', 'T*T***T**');
----
true

query B
SELECT ST_RelateMatch('101010101', 'FF*FF****');
----
false

query B
SELECT ST_RelateMatch('TTTTTTTTT', '1********');
----
false

query B
SELECT ST_RelateMatch('10101010', 'T*T***T*F');
----
true

query B
SELECT ST_RelateMatch(NULL, 'T*T***T**');
----
NULL

statement error length 9
SELECT ST_RelateMatch('101010101', 'T*T***T*');

statement error Unknown dimension symbol: X
SELECT ST_RelateMatch('10101010X', 'T*T***T**');
