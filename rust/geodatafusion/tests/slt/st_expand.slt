query T
SELECT ST_AsText(ST_Expand(ST_GeomFromText('POINT(1 2)'), 1));
----
POLYGON((0 1,0 3,2 3,2 1,0 1))

query T
SELECT ST_AsText(ST_Expand(ST_GeomFromText('LINESTRING(0 1,5 4)'), 1, 2));
----
POLYGON((-1 -1,-1 6,6 6,6 -1,-1 -1))

query T
SELECT ST_AsText(
  ST_Expand(ST_GeomFromText('LINESTRING(0 1,5 4)'), -1, -2, -3, -4)
);
----
POLYGON((1 3,1 2,4 2,4 3,1 3))

query TT
SELECT
  ST_AsText(ST_Expand(ST_GeomFromText('POINT Z (2 3 4)'), 1)),
  ST_AsText(ST_Expand(ST_GeomFromText('LINESTRING M (1 2 3,10 20 30)'), 1, 4, 2, 7));
----
POLYGON Z((1 2 3,1 4 3,3 4 5,3 2 5,1 2 3)) POLYGON M((0 -2 -4,0 24 -4,11 24 37,11 -2 37,0 -2 -4))

query TT
SELECT
  ST_GeometryType(ST_Expand(ST_GeomFromText('POLYGON EMPTY'), 2)),
  ST_AsText(ST_Expand(ST_GeomFromText('POLYGON EMPTY'), 2));
----
ST_Polygon POLYGON EMPTY

query TT
SELECT
  ST_GeometryType(ST_Expand(ST_GeomFromText('GEOMETRYCOLLECTION(POINT EMPTY)'), 2)),
  ST_AsText(ST_Expand(ST_GeomFromText('GEOMETRYCOLLECTION(POINT EMPTY)'), 2));
----
ST_GeometryCollection GEOMETRYCOLLECTION EMPTY

query BB
SELECT
  ST_Expand(ST_GeomFromText(CAST(NULL AS TEXT)), 1) IS NULL,
  ST_Expand(ST_GeomFromText('POINT(0 0)'), CAST(NULL AS DOUBLE)) IS NULL;
----
true true

query B
SELECT ST_Expand(NULL, 1) IS NULL;
----
true

query RRRR
SELECT b.xmin, b.ymin, b.xmax, b.ymax
FROM (
  SELECT ST_Expand(ST_MakeBox2D(ST_Point(0, 5), ST_Point(10, 20)), -20, 30) AS b
);
----
-10.0 -25.0 20.0 50.0

query RRRRRR
SELECT b.xmin, b.ymin, b.zmin, b.xmax, b.ymax, b.zmax
FROM (
  SELECT ST_Expand(
    ST_3DMakeBox(ST_PointZ(-1, 3, 5), ST_PointZ(-1, 6, 8)),
    -4,
    2
  ) AS b
);
----
-5.0 1.0 5.0 3.0 8.0 8.0

query R
SELECT b.xmin
FROM (
  SELECT ST_Expand(
    ST_MakeBox2D(ST_Point(0, 5), ST_Point(10, 20)),
    CAST(NULL AS DOUBLE),
    2
  ) AS b
);
----
NULL
